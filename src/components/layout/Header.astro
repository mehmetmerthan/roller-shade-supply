---
/**
 * Site header, sticky at every width: the main links scroll to Home sections
 * (anchor navigation), so the header has to stay in reach.
 *   < 768 px   logo + Menu (the bottom action bar carries Call / Get a Quote)
 *   768–1023   logo + phone + Request a Quote + Menu
 *   1024–1279  logo + section links + Request a Quote (no room for the phone)
 *   ≥ 1280     logo + section links + phone + Request a Quote
 * On Home, the link for the section in view is marked (scroll-spy below).
 * `html { scroll-padding-top }` in global.css keeps anchors and focused elements
 * clear of the header.
 */
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { mainNav, quoteCta } from '../../config/nav';
import { site } from '../../config/site';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="sticky top-0 z-30 border-b border-ink bg-paper">
  <div class="page-gutter mx-auto flex h-16 max-w-content items-center gap-3 md:h-20 lg:gap-4">
    <a href="/" class="mr-auto shrink-0 py-2 lg:mr-2" aria-current={isHome ? 'page' : undefined}>
      <Logo height={44} imgClass="h-9 w-auto md:h-11" />
    </a>

    <nav aria-label="Main" class="mr-auto hidden lg:block">
      <ul class="flex items-center">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                data-section-link={item.id}
                aria-current={!item.id && path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={site.phone.href}
      class="hidden min-h-11 items-center gap-2 px-1 text-sm font-semibold whitespace-nowrap md:inline-flex lg:hidden xl:inline-flex xl:text-base"
      data-event="click_to_call"
    >
      <Icon name="phone" size={20} />
      <span><span class="sr-only">Call </span>{site.phone.display}</span>
    </a>
    <a
      href={quoteCta.href}
      class="btn btn-primary btn-sm hidden md:inline-flex xl:min-h-12 xl:px-5 xl:text-base"
      aria-current={path === quoteCta.href ? 'page' : undefined}
    >
      {quoteCta.label}
    </a>
    <MobileMenu path={path} class="lg:hidden" />
  </div>
</header>

<script>
  // Mobile menu: fallback for browsers without invoker commands; links close the
  // sheet (they scroll to a Home section or leave the page); close it if the
  // viewport grows past the breakpoint while it is open.
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  if (menu) {
    if (!('command' in HTMLButtonElement.prototype)) {
      for (const b of document.querySelectorAll<HTMLButtonElement>('button[commandfor="mobile-menu"]')) {
        b.addEventListener('click', () => (b.getAttribute('command') === 'show-modal' ? menu.showModal() : menu.close()));
      }
    }
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menu.close();
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (mq) => {
      if (mq.matches && menu.open) menu.close();
    });
  }

  // Scroll-spy (Home only): mark the link of the section crossing the upper third
  // of the viewport. Sections without a header link (e.g., Why Work With Us) clear it.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-home-section]')];
  if (location.pathname === '/' && sections.length > 0) {
    const setCurrent = (id: string | null) => {
      for (const link of links) {
        if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    const visible = new Set<HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target as HTMLElement);
          else visible.delete(entry.target as HTMLElement);
        }
        // The last section (in page order) that crosses the band wins.
        const current = sections.filter((s) => visible.has(s)).at(-1);
        setCurrent(current?.id ?? null);
      },
      { rootMargin: '-30% 0px -65% 0px' },
    );
    for (const s of sections) observer.observe(s);
  }
</script>
