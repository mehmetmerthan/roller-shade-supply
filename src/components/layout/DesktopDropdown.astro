---
/**
 * Header dropdown (Products, Industries) built on <details>: keyboard and touch
 * operable without JS, and only one open at a time (shared `name`).
 * The Header script adds Esc to close (focus returns to the toggle), outside click,
 * and closing when focus leaves the menu.
 * The panel rolls down like a shade when opened (user-triggered; off under reduced motion).
 */
import Icon from '../ui/Icon.astro';
import type { NavItem } from '../../config/nav';

interface Props {
  item: NavItem;
  /** Current pathname, for aria-current. */
  path: string;
}

const { item, path } = Astro.props;
const links = [{ label: `All ${item.label}`, href: item.href }, ...(item.children ?? [])];
const inSection = path.startsWith(item.href);
---

<details class="nav-dropdown relative" name="main-nav" data-nav-dropdown>
  <summary class="disclosure-summary nav-link" data-current={inSection ? '' : undefined}>
    {item.label}
    <Icon name="chevron-down" size={16} class="disclosure-chevron transition-transform" />
  </summary>
  <div class="nav-panel absolute top-full left-0 z-50 mt-2 w-72 border border-t-4 border-ink bg-paper">
    <ul>
      {
        links.map((link, i) => (
          <li class:list={[i > 0 && 'border-t border-line']}>
            <a
              href={link.href}
              class:list={['flex min-h-12 items-center px-4 py-2 font-semibold hover:bg-stone-100', i === 0 && 'text-sm text-stone-700']}
              aria-current={path === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .nav-dropdown[open] .nav-panel {
      animation: roll-down 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }
  @keyframes roll-down {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  .nav-panel a[aria-current="page"] {
    box-shadow: inset 4px 0 0 var(--color-ink);
  }
</style>
