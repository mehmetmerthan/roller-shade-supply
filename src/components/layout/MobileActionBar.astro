---
/**
 * Sticky bottom bar on phones (below 768 px): Request a Quote, always one tap away on
 * a job site. BaseLayout pads the page so the bar never covers content. No Call
 * button: the site shows no phone number (client decision, 11/17/2026).
 */
import { mobileActions } from '../../config/nav';
---

<nav aria-label="Quick actions" class="action-bar fixed inset-x-0 bottom-0 z-40 md:hidden" data-surface="dark">
  <div class="px-2 pt-2">
    <a href={mobileActions.quoteHref} class="btn btn-primary w-full">{mobileActions.quoteLabel}</a>
  </div>
</nav>

<style>
  .action-bar {
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
  }
</style>
