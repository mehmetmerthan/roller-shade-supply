---
/**
 * Full-screen menu below 1024 px: a modal <dialog> (focus is trapped, Esc closes,
 * focus returns to the Menu button). The buttons use native invoker commands
 * (`commandfor` / `command`), so the menu opens without JS in current browsers;
 * the Header script adds a fallback for browsers without them.
 * Products and Industries are <details> groups. The sheet rolls down like a shade
 * when it opens (user-triggered; off under reduced motion).
 */
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { mainNav, quoteCta } from '../../config/nav';
import { site } from '../../config/site';

interface Props {
  path: string;
  class?: string;
}

const { path, class: className } = Astro.props;
const id = 'mobile-menu';
---

<button
  type="button"
  class:list={['btn btn-ghost btn-sm min-h-12 gap-2 px-3', className]}
  commandfor={id}
  command="show-modal"
  aria-haspopup="dialog"
  data-menu-open
>
  <Icon name="menu" size={24} />
  Menu
</button>

<dialog id={id} class="mobile-menu" aria-label="Menu">
  <div class="page-gutter flex h-16 items-center justify-between gap-4 border-b border-ink md:h-20">
    <a href="/" class="py-2" aria-current={path === '/' ? 'page' : undefined}><Logo height={36} /></a>
    <button type="button" class="btn btn-ghost btn-sm min-h-12 gap-2 px-3" commandfor={id} command="close" autofocus>
      Close
      <Icon name="close" size={24} />
    </button>
  </div>

  <nav aria-label="Main" class="page-gutter">
    <ul class="border-b border-ink">
      {
        mainNav.map((item) =>
          item.children ? (
            <li class="border-t border-line first:border-t-0">
              <details open={path.startsWith(item.href)}>
                <summary class="disclosure-summary flex min-h-14 cursor-pointer items-center justify-between font-display text-2xl font-extrabold">
                  {item.label}
                  <Icon name="chevron-down" size={24} class="disclosure-chevron" />
                </summary>
                <ul class="pb-3">
                  {[{ label: `All ${item.label}`, href: item.href }, ...item.children].map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex min-h-12 items-center border-l-4 border-line pl-4 font-semibold aria-[current=page]:border-ink"
                        aria-current={path === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li class="border-t border-line">
              <a
                href={item.href}
                class="flex min-h-14 items-center font-display text-2xl font-extrabold aria-[current=page]:underline aria-[current=page]:decoration-4 aria-[current=page]:underline-offset-4"
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>

  <div class="page-gutter grid gap-3 py-6 sm:grid-cols-2">
    <a href={quoteCta.href} class="btn btn-primary w-full">{quoteCta.label}</a>
    <a href={site.phone.href} class="btn btn-secondary w-full" data-event="click_to_call">
      <Icon name="phone" />
      Call {site.phone.display}
    </a>
    <p class="text-sm text-stone-700 sm:col-span-2">
      <a class="link" href={`mailto:${site.email.quotes}`} data-event="email_click">{site.email.quotes}</a>
      <br />
      {site.hours.display}
    </p>
  </div>
</dialog>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu::backdrop {
    background: transparent;
  }
  :global(html:has(.mobile-menu[open])) {
    overflow: hidden;
  }

  /* Roll-down: the sheet lowers from the head rail like a shade. */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu {
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 240ms cubic-bezier(0.2, 0.7, 0.2, 1),
        overlay 240ms allow-discrete,
        display 240ms allow-discrete;
    }
    .mobile-menu[open] {
      clip-path: inset(0);
    }
    @starting-style {
      .mobile-menu[open] {
        clip-path: inset(0 0 100% 0);
      }
    }
  }
</style>
