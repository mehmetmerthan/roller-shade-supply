---
/**
 * Ruled spec table (label | value), the submittal-sheet way to show project facts.
 * Replaces dot-joined metadata strings.
 * layout "stacked" puts the label above the value, for narrow columns (sashes).
 */
export interface SpecItem {
  label: string;
  value: string;
}

interface Props {
  items: SpecItem[];
  /** "compact" for cards and sashes, "default" for spec panels. */
  size?: 'compact' | 'default';
  layout?: 'inline' | 'stacked';
  class?: string;
}

const { items, size = 'default', layout = 'inline', class: className } = Astro.props;
const compact = size === 'compact';
---

<dl class:list={[layout === 'stacked' ? 'divide-y divide-line' : 'border-b border-line', className]}>
  {
    items.map((item) =>
      layout === 'stacked' ? (
        <div class="py-2 first:pt-0 last:pb-0">
          <dt class="label-spec">{item.label}</dt>
          <dd class:list={['mt-0.5', compact ? 'text-sm' : 'text-base']}>{item.value}</dd>
        </div>
      ) : (
        <div class:list={['flex gap-4 border-t border-line', compact ? 'py-1.5' : 'py-3']}>
          <dt class:list={['label-spec shrink-0', compact ? 'w-20 pt-0.5' : 'w-32 pt-1']}>{item.label}</dt>
          <dd class:list={[compact ? 'text-sm' : 'text-base']}>{item.value}</dd>
        </div>
      ),
    )
  }
</dl>
