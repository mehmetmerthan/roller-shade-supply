---
/**
 * Project carousel (docs/site-spec.md §5.1): native horizontal scroll with snap
 * points. Without JS it is a plain scrollable row. With JS: previous/next buttons
 * (inactive at the ends, no loop), ←/→ and Home/End while the track has focus, and a
 * polite live region. No autoplay. Every slide reserves its 4:3 box; covers load lazily.
 */
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import type { Project } from '../../lib/projects';

interface Props {
  projects: Project[];
  /** Accessible name of the carousel region. */
  label: string;
  id: string;
  headingLevel?: 2 | 3;
  class?: string;
}

const { projects, label, id, headingLevel = 3, class: className } = Astro.props;
const total = projects.length;
const sizes = '(min-width: 1280px) 400px, (min-width: 1024px) 31vw, (min-width: 768px) 47vw, 84vw';
---

<section
  class:list={['carousel', className]}
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel
>
  <div id={`${id}-track`} class="carousel-track" tabindex="0" aria-label={`${label}, scrollable`} data-track>
    {
      projects.map((project, i) => (
        <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${total}`}>
          <ProjectCard project={project} headingLevel={headingLevel} sizes={sizes} class="h-full" />
        </div>
      ))
    }
  </div>

  {/* One bar under the track: arrows (JS only) on the right, the `actions` slot on the left. */}
  <div class="mt-4 flex flex-col gap-4 border-t border-line pt-4 sm:flex-row-reverse sm:items-center sm:justify-between">
    <div class="flex items-center justify-end gap-4" data-controls hidden>
      <p class="text-sm text-stone-700 tabular-nums" aria-hidden="true" data-counter></p>
      <div class="flex gap-2">
        <button type="button" class="btn btn-secondary btn-icon" aria-controls={`${id}-track`} aria-label="Previous project" data-prev>
          <Icon name="arrow-left" size={24} />
        </button>
        <button type="button" class="btn btn-secondary btn-icon" aria-controls={`${id}-track`} aria-label="Next project" data-next>
          <Icon name="arrow-right" size={24} />
        </button>
      </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6"><slot name="actions" /></div>
  </div>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-live></p>
</section>

<style>
  /* Slides: 84% on phones (the next card peeks in), 2 up from 768 px, 3 up from 1024 px.
     Percentages resolve against the track's content box (inside the bleed padding). */
  .carousel-track {
    --gap: 1rem;
    --bleed: 1rem;
    position: relative; /* offsetParent for the slides */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Bleed to the viewport edge on small screens; keep room for focus rings. */
    margin-inline: calc(var(--bleed) * -1);
    padding: 0.5rem var(--bleed) 1.25rem;
    scroll-padding-inline: var(--bleed);
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink) var(--color-stone-100);
  }
  @media (width >= 48rem) {
    .carousel-track {
      --gap: 1.5rem;
      --bleed: 1.5rem;
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }
  @media (width >= 64rem) {
    .carousel-track {
      --gap: 2rem;
      --bleed: 0.5rem;
      grid-auto-columns: calc((100% - 2 * var(--gap)) / 3);
    }
  }
  .carousel-slide {
    scroll-snap-align: start;
  }
  .carousel-track:focus-visible {
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .carousel-track {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('[aria-roledescription="slide"]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const counter = root.querySelector<HTMLElement>('[data-counter]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const total = slides.length;

    /** Index range of slides that are at least mostly in view. */
    const visibleRange = () => {
      const box = track.getBoundingClientRect();
      const inView = slides
        .map((s, i) => ({ i, r: s.getBoundingClientRect() }))
        .filter(({ r }) => r.left >= box.left - r.width * 0.25 && r.right <= box.right + r.width * 0.25);
      if (inView.length === 0) return { first: 0, last: 0 };
      return { first: inView[0].i, last: inView.at(-1)!.i };
    };

    const rangeText = () => {
      const { first, last } = visibleRange();
      return first === last ? `${first + 1} of ${total}` : `${first + 1}–${last + 1} of ${total}`;
    };

    const update = () => {
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      prev.setAttribute('aria-disabled', String(atStart));
      next.setAttribute('aria-disabled', String(atEnd));
      counter.textContent = rangeText();
      // Hide the controls when everything fits.
      controls.hidden = atStart && atEnd;
    };

    let announce = false;
    const go = (index: number) => {
      const target = slides[Math.max(0, Math.min(total - 1, index))];
      const padding = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
      track.scrollTo({ left: target.offsetLeft - padding });
      announce = true;
    };
    const step = (dir: 1 | -1) => {
      const { first } = visibleRange();
      go(first + dir);
    };

    prev.addEventListener('click', () => prev.getAttribute('aria-disabled') !== 'true' && step(-1));
    next.addEventListener('click', () => next.getAttribute('aria-disabled') !== 'true' && step(1));
    track.addEventListener('keydown', (e) => {
      if (e.target !== track) return;
      const keys: Record<string, () => void> = {
        ArrowLeft: () => step(-1),
        ArrowRight: () => step(1),
        Home: () => go(0),
        End: () => go(total - 1),
      };
      if (keys[e.key]) {
        e.preventDefault();
        keys[e.key]();
      }
    });

    let frame = 0;
    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (announce) live.textContent = `Showing projects ${rangeText()}`;
          announce = false;
        }, 300);
      },
      { passive: true },
    );
    new ResizeObserver(update).observe(track);
    controls.hidden = false;
    update();
  }
</script>
