---
/**
 * Labeled text input or textarea with hint and error.
 * Required fields say "(required)" in the label. Errors set aria-invalid and are
 * linked with aria-describedby; the message starts with an icon and "Error:" for screen readers.
 *
 * `messages` turns on client-side validation (src/lib/form-validation.ts): the error
 * slot is rendered hidden and the messages ride on the control as data attributes.
 * `error` renders a static error (styleguide).
 */
import AlertIcon from './AlertIcon.astro';

interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'url' | 'textarea';
  required?: boolean;
  hint?: string;
  error?: string;
  /** Client-side messages: `required` (empty) and `format` (e.g., invalid email). */
  messages?: { required?: string; format?: string };
  value?: string;
  placeholder?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'tel' | 'numeric' | 'decimal' | 'url';
  min?: number;
  maxlength?: number;
  disabled?: boolean;
  rows?: number;
  /** Styleguide only: force a visual state. */
  demo?: 'hover' | 'focus';
  class?: string;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  required = false,
  hint,
  error,
  messages,
  value,
  placeholder,
  autocomplete,
  inputmode,
  min,
  maxlength,
  disabled = false,
  rows = 5,
  demo,
  class: className,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = error || messages ? `${id}-error` : undefined;
const describedBy = [hintId, error && errorId].filter(Boolean).join(' ') || undefined;
const common = {
  id,
  name,
  required,
  disabled,
  placeholder,
  autocomplete,
  maxlength,
  'aria-invalid': error ? ('true' as const) : undefined,
  'aria-describedby': describedBy,
  'data-validate': messages ? '' : undefined,
  'data-msg-required': messages?.required,
  'data-msg-format': messages?.format,
  'data-demo': demo,
  class: 'field-control',
};
---

<div class={className}>
  <label for={id} class="field-label">
    {label}{required && <span class="field-required"> (required)</span>}
  </label>
  {hint && <p id={hintId} class="field-hint">{hint}</p>}
  {
    type === 'textarea' ? (
      <textarea {...common} rows={rows}>{value}</textarea>
    ) : (
      <input {...common} type={type} value={value} inputmode={inputmode} min={min} />
    )
  }
  {
    errorId && (
      <p id={errorId} class="field-error" hidden={!error}>
        <AlertIcon />
        <span><span class="sr-only">Error: </span><span data-error-text>{error}</span></span>
      </p>
    )
  }
</div>
