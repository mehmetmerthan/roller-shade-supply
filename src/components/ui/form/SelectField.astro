---
/** Labeled native select with hint and error (same rules as TextField, including `messages`). */
import AlertIcon from './AlertIcon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: Option[];
  name?: string;
  required?: boolean;
  hint?: string;
  error?: string;
  /** Client-side message shown when nothing is selected. */
  messages?: { required?: string };
  value?: string;
  /** First, empty option. */
  placeholder?: string;
  disabled?: boolean;
  demo?: 'hover' | 'focus';
  class?: string;
}

const {
  id,
  label,
  options,
  name = id,
  required = false,
  hint,
  error,
  messages,
  value,
  placeholder = 'Select one',
  disabled = false,
  demo,
  class: className,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = error || messages ? `${id}-error` : undefined;
const describedBy = [hintId, error && errorId].filter(Boolean).join(' ') || undefined;
---

<div class={className}>
  <label for={id} class="field-label">
    {label}{required && <span class="field-required"> (required)</span>}
  </label>
  {hint && <p id={hintId} class="field-hint">{hint}</p>}
  <select
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    data-validate={messages ? '' : undefined}
    data-msg-required={messages?.required}
    data-demo={demo}
    class="field-control"
  >
    <option value="" selected={!value}>{placeholder}</option>
    {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
  </select>
  {
    errorId && (
      <p id={errorId} class="field-error" hidden={!error}>
        <AlertIcon />
        <span><span class="sr-only">Error: </span><span data-error-text>{error}</span></span>
      </p>
    )
  }
</div>
