---
/** Alert glyph used with every error message (never color alone). Decorative. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d="M8 1.2 15.2 14.4H.8z" fill="currentColor"></path>
  <path d="M8 5.6v4.4" stroke="#fff" stroke-width="1.7" stroke-linecap="square"></path>
  <circle cx="8" cy="12.1" r="1" fill="#fff"></circle>
</svg>
