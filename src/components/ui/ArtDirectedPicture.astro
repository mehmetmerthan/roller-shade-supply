---
/**
 * <picture> with a different crop per breakpoint (Astro's <Picture> only resizes).
 * Each source is cropped at the photo's focal point by the custom image service
 * (exact percentage crops) and offered as AVIF and WebP; the last source is the
 * JPEG fallback <img>. Reserve the box with aspect-ratio classes on `class`.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Source {
  /** Omit on the last source (the fallback). */
  media?: string;
  width: number;
  height: number;
  widths: number[];
  sizes: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS object-position, e.g. "55% 30%". */
  position?: string;
  /** Largest breakpoint first; the last entry has no `media` and is the fallback. */
  sources: Source[];
  priority?: boolean;
  class?: string;
}

const { src, alt, position = '50% 50%', sources, priority = false, class: className } = Astro.props;

const crop = (s: Source, format: 'avif' | 'webp' | 'jpg') =>
  getImage({ src, width: s.width, height: s.height, widths: s.widths, format, fit: 'cover', position });

const rendered = await Promise.all(
  sources.map(async (s) => ({
    ...s,
    avif: await crop(s, 'avif'),
    webp: await crop(s, 'webp'),
    jpg: s.media ? undefined : await crop(s, 'jpg'),
  })),
);
const fallback = rendered.at(-1)!;
if (fallback.media || !fallback.jpg) throw new Error('ArtDirectedPicture: the last source must not have `media`.');
---

<picture>
  {
    rendered.map((s) => (
      <>
        <source type="image/avif" media={s.media} srcset={s.avif.srcSet.attribute} sizes={s.sizes} width={s.width} height={s.height} />
        <source type="image/webp" media={s.media} srcset={s.webp.srcSet.attribute} sizes={s.sizes} width={s.width} height={s.height} />
      </>
    ))
  }
  <img
    src={fallback.jpg.src}
    srcset={fallback.jpg.srcSet.attribute}
    sizes={fallback.sizes}
    width={fallback.width}
    height={fallback.height}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class:list={['block w-full object-cover', className]}
  />
</picture>
