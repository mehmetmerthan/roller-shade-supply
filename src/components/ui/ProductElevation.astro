---
/**
 * Elevation drawing of a product in a window opening, drawn like a submittal cut sheet
 * (rough opening, W × H dimension lines). Line art in the brand palette; decorative.
 */
interface Props {
  product: 'roller-shades' | 'zebra-shades' | 'faux-wood-blinds';
  class?: string;
}

const { product, class: className } = Astro.props;

// Zebra: alternating solid / sheer bands.
const zebraBands = Array.from({ length: 8 }, (_, i) => ({ y: 40 + i * 14, solid: i % 2 === 0 }));
// Faux wood: slats on a 11-unit pitch.
const slats = Array.from({ length: 12 }, (_, i) => 42 + i * 11);
---

<svg
  class:list={['block h-auto w-full', className]}
  viewBox="0 0 320 240"
  aria-hidden="true"
  focusable="false"
>
  <!-- Rough opening with glass -->
  <rect x="64" y="28" width="192" height="168" class="fill-paper stroke-ink" stroke-width="2"></rect>
  <path d="M206 186 L248 144 M224 186 L248 162" class="stroke-stone-300" stroke-width="1.5" fill="none"></path>

  {
    product === 'roller-shades' && (
      <g>
        <rect x="60" y="22" width="200" height="14" class="fill-ink" />
        <rect x="70" y="36" width="168" height="98" class="fill-stone-200" />
        <rect x="68" y="134" width="172" height="5" class="fill-ink" />
        <path d="M246 36 V176 M251 36 V176" class="stroke-ink" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="0.1 4" />
        <rect x="243" y="176" width="11" height="9" class="fill-ink" />
      </g>
    )
  }

  {
    product === 'zebra-shades' && (
      <g>
        <rect x="60" y="20" width="200" height="20" rx="3" class="fill-ink" />
        {zebraBands.map((b) => (
          <rect x="70" y={b.y} width="168" height="14" class={b.solid ? 'fill-stone-300' : 'fill-stone-100'} />
        ))}
        <rect x="68" y="152" width="172" height="6" class="fill-ink" />
        <path d="M246 40 V176 M251 40 V176" class="stroke-ink" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="0.1 4" />
        <rect x="243" y="176" width="11" height="9" class="fill-ink" />
      </g>
    )
  }

  {
    product === 'faux-wood-blinds' && (
      <g>
        <rect x="60" y="24" width="200" height="12" class="fill-ink" />
        {slats.map((y) => (
          <rect x="68" y={y} width="184" height="7" class="fill-white stroke-stone-400" stroke-width="0.75" />
        ))}
        <path d="M110 36 V180 M210 36 V180" class="stroke-stone-600" stroke-width="0.75" />
        <rect x="66" y="176" width="188" height="7" class="fill-ink" />
        <path d="M76 36 V122" class="stroke-ink" stroke-width="2.5" stroke-linecap="round" />
      </g>
    )
  }

  <!-- Dimension lines -->
  <g class="stroke-stone-600" stroke-width="1" fill="none">
    <path d="M40 28 V196 M35 28 H45 M35 196 H45"></path>
    <path d="M64 216 H256 M64 211 V221 M256 211 V221"></path>
  </g>
  <g class="fill-stone-600" font-family="var(--font-sans)" font-size="12" font-weight="600" text-anchor="middle">
    <text x="26" y="116">H</text>
    <text x="160" y="236">W</text>
  </g>
</svg>
