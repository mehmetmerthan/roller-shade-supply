---
/**
 * Project detail gallery (docs/site-spec.md §5.1, §5.3) in a Chicago window:
 *   pane        the stage: a native scroll-snap track, one photo per slide (letterboxed
 *               on ink, so portraits are never cropped)
 *   left sash   counter, caption (the photo's alt text), previous / next, full screen
 *   right sash  the contact sheet: thumbnails that jump to a photo
 * Each slide links to a 2048 px version, so without JS a click opens the full photo;
 * with JS, PhotoSwipe opens it in a lightbox (focus trap, Esc, arrows, focus returns).
 * No autoplay, no loop. Only the first photo loads eagerly.
 */
import { Picture, getImage } from 'astro:assets';
import ChicagoWindow from './ChicagoWindow.astro';
import Icon from './Icon.astro';
import type { ProjectPhoto } from '../../lib/projects';

interface Props {
  photos: ProjectPhoto[];
  /** Project title, for accessible names. */
  title: string;
  id?: string;
}

const { photos, title, id = 'gallery' } = Astro.props;
const total = photos.length;
const multiple = total > 1;

const LIGHTBOX_LONG_EDGE = 2048;
const slides = await Promise.all(
  photos.map(async (photo) => {
    const { width, height } = photo.src;
    const scale = Math.min(1, LIGHTBOX_LONG_EDGE / Math.max(width, height));
    const largeWidth = Math.round(width * scale);
    const large = await getImage({ src: photo.src, width: largeWidth, format: 'webp' });
    return { ...photo, large: { src: large.src, width: largeWidth, height: Math.round(height * scale) } };
  }),
);
const label = (i: number) => `Photo ${i + 1} of ${total}`;
/** Responsive widths up to the photo's own width (web images can be small). */
const widthsFor = (w: number) => [...[480, 800, 1200, 1600].filter((x) => x < w), Math.min(w, 1600)];
---

<section class="gallery" data-gallery id={id} aria-roledescription={multiple ? 'carousel' : undefined} aria-label={`Photos of ${title}`}>
  <ChicagoWindow from="xl" sash="paper" class="-mx-4 md:-mx-6 lg:mx-0">
    <Fragment slot="left">
      <div>
        {multiple && <p class="font-display text-2xl font-extrabold tabular-nums" data-gallery-counter>{total} photos</p>}
        <p class="mt-2 text-sm text-stone-700" aria-hidden="true" data-gallery-caption>{photos[0].alt}</p>
      </div>
      <div data-rail="bottom" class="flex flex-wrap items-center gap-2">
        {
          multiple && (
            <div class="flex gap-2" data-gallery-controls hidden>
              <button type="button" class="btn btn-secondary btn-icon" aria-controls={`${id}-track`} aria-label="Previous photo" aria-disabled="true" data-gallery-prev>
                <Icon name="arrow-left" size={24} />
              </button>
              <button type="button" class="btn btn-secondary btn-icon" aria-controls={`${id}-track`} aria-label="Next photo" data-gallery-next>
                <Icon name="arrow-right" size={24} />
              </button>
            </div>
          )
        }
        <button type="button" class="btn btn-ghost btn-sm gap-2 px-2" data-gallery-fullscreen hidden>
          <Icon name="expand" />
          Full screen
        </button>
      </div>
    </Fragment>

    <div
      id={`${id}-track`}
      class:list={['gallery-track aspect-4/3 bg-ink', !multiple && 'xl:aspect-video']}
      tabindex={multiple ? 0 : undefined}
      aria-label={multiple ? `${title} photos, scrollable` : undefined}
      data-gallery-track
    >
      {
        slides.map((slide, i) => (
          <div class="gallery-slide" id={`${id}-photo-${i + 1}`} role={multiple ? 'group' : undefined} aria-roledescription={multiple ? 'slide' : undefined} aria-label={multiple ? label(i) : undefined}>
            <a
              href={slide.large.src}
              class="block h-full w-full"
              data-pswp-width={slide.large.width}
              data-pswp-height={slide.large.height}
            >
              <span class="sr-only">Open full-size photo{multiple && ` ${i + 1} of ${total}`}: </span>
              <Picture
                src={slide.src}
                alt={slide.alt}
                widths={widthsFor(slide.src.width)}
                sizes="(min-width: 1280px) 800px, (min-width: 1024px) calc(100vw - 4rem), 100vw"
                formats={['avif', 'webp']}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                pictureAttributes={{ class: 'block h-full w-full' }}
                class="h-full w-full object-contain"
              />
            </a>
          </div>
        ))
      }
    </div>

    {
      multiple && (
        <Fragment slot="right">
          <p class="label-spec" id={`${id}-sheet`}>
            All photos
          </p>
          <div class="gallery-sheet">
            <ul class="gallery-thumbs" aria-labelledby={`${id}-sheet`}>
              {slides.map((slide, i) => (
                <li>
                  <a href={`#${id}-photo-${i + 1}`} class="gallery-thumb" aria-label={`Show ${label(i).toLowerCase()}`} data-gallery-thumb={i}>
                    <Picture
                      src={slide.src}
                      alt=""
                      width={160}
                      height={120}
                      fit="cover"
                      position={slide.position}
                      widths={[160, 320]}
                      sizes="(min-width: 1280px) 72px, 96px"
                      formats={['avif', 'webp']}
                      class="block aspect-4/3 h-auto w-full"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </Fragment>
      )
    }
  </ChicagoWindow>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-gallery-live></p>
</section>

<style>
  .gallery-track {
    position: relative; /* offsetParent for the slides */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    /* One row exactly as tall as the stage: otherwise a portrait photo's intrinsic
       height sets the row and every slide overflows the 4:3 frame. */
    grid-template-rows: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-track:focus-visible {
    outline-color: var(--color-focus);
    outline-offset: -6px;
    outline-width: 3px;
  }
  .gallery-slide {
    scroll-snap-align: start;
    min-width: 0;
    min-height: 0;
  }
  .gallery-slide a:focus-visible {
    outline: 3px solid var(--color-paper);
    outline-offset: -6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gallery-track {
      scroll-behavior: smooth;
    }
  }

  /* Contact sheet: a scrolling strip on phones, a grid from 768 px, and from 1280 px a
     two-column sheet that scrolls inside the sash without stretching the frame. */
  .gallery-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem;
    margin: -0.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink) var(--color-stone-100);
  }
  .gallery-thumbs li {
    flex: none;
    width: 6rem;
  }
  @media (width >= 48rem) {
    .gallery-thumbs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
      overflow: visible;
    }
    .gallery-thumbs li {
      width: auto;
    }
  }
  @media (width >= 80rem) {
    .gallery-sheet {
      position: relative;
      flex: 1;
      min-height: 0;
    }
    .gallery-thumbs {
      position: absolute;
      inset: 0;
      grid-template-columns: 1fr 1fr;
      align-content: start;
      overflow-y: auto;
    }
  }
  .gallery-thumb {
    display: block;
    outline-offset: 1px;
    opacity: 0.75;
    transition: opacity 120ms ease;
  }
  .gallery-thumb:hover,
  .gallery-thumb[aria-current="true"] {
    opacity: 1;
  }
  /* Current photo: a 3 px steel frame (not color alone: it also gets full opacity). */
  .gallery-thumb[aria-current="true"] {
    box-shadow: 0 0 0 3px var(--color-ink);
  }
</style>

<style is:global>
  /* PhotoSwipe on structural steel; focus rings in paper. */
  .pswp {
    --pswp-bg: var(--color-ink);
    --pswp-icon-color: var(--color-paper);
    --pswp-icon-color-secondary: var(--color-ink);
    --pswp-icon-stroke-color: var(--color-ink);
    --pswp-placeholder-bg: var(--color-stone-800);
    --pswp-error-text-color: var(--color-paper);
  }
  .pswp__button:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: -4px;
  }
  .pswp__counter {
    font-family: var(--font-sans);
    font-weight: 600;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = root.querySelector<HTMLElement>('[data-gallery-track]')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.gallery-slide')];
    const total = slides.length;
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
    const caption = root.querySelector<HTMLElement>('[data-gallery-caption]')!;
    const controls = root.querySelector<HTMLElement>('[data-gallery-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const fullscreen = root.querySelector<HTMLButtonElement>('[data-gallery-fullscreen]')!;
    const thumbs = [...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]')];
    const live = root.querySelector<HTMLElement>('[data-gallery-live]')!;
    const alts = slides.map((s) => s.querySelector('img')?.alt ?? '');

    let index = 0;
    let announce = false;

    const update = () => {
      // Slide widths can be fractional; measure one instead of trusting clientWidth.
      const slideWidth = slides[0].getBoundingClientRect().width || 1;
      const i = Math.round(track.scrollLeft / slideWidth);
      if (i === index && counter?.dataset.ready) return;
      index = Math.max(0, Math.min(total - 1, i));
      if (counter) {
        counter.textContent = `${index + 1} / ${total}`;
        counter.dataset.ready = '1';
      }
      caption.textContent = alts[index];
      prev?.setAttribute('aria-disabled', String(index === 0));
      next?.setAttribute('aria-disabled', String(index === total - 1));
      thumbs.forEach((t, j) => (j === index ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    };

    const go = (i: number, behavior: ScrollBehavior | undefined = undefined) => {
      const target = slides[Math.max(0, Math.min(total - 1, i))];
      track.scrollTo({ left: target.offsetLeft, behavior });
      announce = true;
    };

    if (total > 1) {
      prev!.addEventListener('click', () => prev!.getAttribute('aria-disabled') !== 'true' && go(index - 1));
      next!.addEventListener('click', () => next!.getAttribute('aria-disabled') !== 'true' && go(index + 1));
      track.addEventListener('keydown', (e) => {
        if (e.target !== track) return;
        const keys: Record<string, number> = { ArrowLeft: index - 1, ArrowRight: index + 1, Home: 0, End: total - 1 };
        if (e.key in keys) {
          e.preventDefault();
          go(keys[e.key]);
        }
      });
      thumbs.forEach((t, j) =>
        t.addEventListener('click', (e) => {
          e.preventDefault();
          go(j);
        }),
      );
      let frame = 0;
      let settle = 0;
      track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(update);
          clearTimeout(settle);
          settle = window.setTimeout(() => {
            if (announce) live.textContent = `Photo ${index + 1} of ${total}`;
            announce = false;
            thumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          }, 250);
        },
        { passive: true },
      );
      controls!.hidden = false;
    }

    const lightbox = new PhotoSwipeLightbox({
      gallery: track,
      children: 'a[data-pswp-width]',
      pswpModule: () => import('photoswipe'),
      loop: false,
      bgOpacity: 1,
      // Fade, not zoom: the inline photos are letterboxed, so a zoom from them looks wrong.
      showHideAnimationType: 'fade',
      padding: { top: 48, bottom: 48, left: 16, right: 16 },
      // Focus is returned by hand (below): returning it to the opening photo link would
      // scroll the track back to that photo.
      returnFocus: false,
      closeTitle: 'Close (Esc)',
      zoomTitle: 'Zoom',
      arrowPrevTitle: 'Previous photo',
      arrowNextTitle: 'Next photo',
      errorMsg: 'This photo could not be loaded.',
      indexIndicatorSep: ' / ',
    });
    // After closing: stay on the photo the visitor ended on, then put focus back on what
    // opened the lightbox (Full screen) or on that photo's link, without scrolling.
    // PhotoSwipe 5.4 waits for the large photo before it finishes opening, and only binds
    // its keyboard handler (and accepts close()) once open. An Esc or Close during that
    // wait was lost. Catch it and close as soon as the opening animation ends.
    // An Esc even earlier, while the PhotoSwipe module is still loading (no instance
    // yet), is remembered from the moment opening is requested.
    let requested = false;
    let escBeforeInit = false;
    const loadAndOpen = lightbox.loadAndOpen.bind(lightbox);
    lightbox.loadAndOpen = (...args: Parameters<typeof loadAndOpen>) => {
      requested = true;
      escBeforeInit = false;
      const opening = loadAndOpen(...args);
      if (!opening) requested = false;
      return opening;
    };
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && requested && !lightbox.pswp) {
        e.preventDefault();
        escBeforeInit = true;
      }
    });
    lightbox.on('beforeOpen', () => {
      const pswp = lightbox.pswp;
      requested = false;
      if (!pswp) return;
      let pending = false;
      const closeWhenOpen = () => {
        if (pending) return;
        pending = true;
        pswp.on('openingAnimationEnd', () => setTimeout(() => pswp.close(), 0));
      };
      const close = pswp.close.bind(pswp);
      pswp.close = () => (pswp.opener.isOpen ? close() : closeWhenOpen());
      const earlyEsc = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && !pswp.opener.isOpen) {
          e.preventDefault();
          closeWhenOpen();
        }
      };
      document.addEventListener('keydown', earlyEsc);
      pswp.on('bindEvents', () => document.removeEventListener('keydown', earlyEsc));
      pswp.on('destroy', () => document.removeEventListener('keydown', earlyEsc));
      if (escBeforeInit) {
        escBeforeInit = false;
        closeWhenOpen();
      }
    });

    let openedFromButton = false;
    let lastIndex = 0;
    const rememberIndex = () => {
      lastIndex = lightbox.pswp?.currIndex ?? lastIndex;
    };
    lightbox.on('afterInit', rememberIndex);
    lightbox.on('change', rememberIndex);
    lightbox.on('destroy', () => {
      if (lastIndex !== index) go(lastIndex, 'instant');
      announce = false;
      const target = openedFromButton ? fullscreen : slides[lastIndex].querySelector('a');
      target?.focus({ preventScroll: true });
      openedFromButton = false;
    });
    lightbox.init();

    fullscreen.addEventListener('click', () => {
      openedFromButton = true;
      lastIndex = index;
      lightbox.loadAndOpen(index, { gallery: track });
    });
    fullscreen.hidden = false;
    update();
  }
</script>
