---
/**
 * The standard card: a Chicago-window frame with a limestone text sash on the left
 * and a project photo in the pane on the right, divided by a 4 px steel mullion.
 * Phones: the sash sits above the photo, so the heading reads first.
 *
 * Variants
 * - "hero": the whole photo, never cropped, always on the first screen. Side by side
 *   from 768 px. The pane keeps the photo's 4:3 and its height is the smaller of
 *   "7/12 of the content width × 3/4" and "viewport height − header − padding", so on
 *   short or wide screens the photo gets smaller instead of falling below the fold.
 *   The sash takes the remaining width.
 * - "default": side by side from 1024 px, text `sashSpan` columns, photo the rest.
 *   The pane is never shorter than the photo's aspect and stretches (with a focal
 *   crop) when the text is taller.
 *
 * The sash is a size container, so its content can scale type with `cqi` units.
 * Default slot = sash content.
 */
import ArtDirectedPicture from './ArtDirectedPicture.astro';
import type { ProjectPhoto } from '../../lib/projects';

interface Props {
  photo: ProjectPhoto;
  variant?: 'hero' | 'default';
  /** Default variant: text columns (of 12) from 1024 px. */
  sashSpan?: 5 | 6 | 7;
  /** Above-the-fold photo: eager + high fetch priority. */
  priority?: boolean;
  class?: string;
}

const { photo, variant = 'default', sashSpan = 7, priority = false, class: className } = Astro.props;
const { width, height } = photo.src;
const portrait = height > width;
if (variant === 'hero' && portrait) {
  throw new Error('FeatureCard: the hero variant needs a landscape (4:3) photo.');
}

// Static class strings so Tailwind can see them.
const spans = {
  5: { sash: 'lg:col-span-5', pane: 'lg:col-span-7' },
  6: { sash: 'lg:col-span-6', pane: 'lg:col-span-6' },
  7: { sash: 'lg:col-span-7', pane: 'lg:col-span-5' },
}[sashSpan];
const hero = variant === 'hero';

// Hero: the native 4:3 at every width (no crop). Default: the photo's own orientation,
// 3:4 or 4:3, cropped at its focal point; CSS cover handles any extra stretch.
const sources = hero
  ? [
      {
        width: 2048,
        height: 1536,
        widths: [480, 640, 800, 1024, 1280, 1600, 2048],
        sizes: '(min-width: 80rem) 720px, (min-width: 48rem) 58vw, 100vw',
      },
    ]
  : [
      {
        width: portrait ? 1200 : 1600,
        height: portrait ? 1600 : 1200,
        widths: portrait ? [480, 720, 960, 1200] : [640, 960, 1280, 1600],
        sizes: `(min-width: 80rem) ${Math.round((1216 * (12 - sashSpan)) / 12)}px, (min-width: 64rem) ${Math.round(((12 - sashSpan) / 12) * 100)}vw, 100vw`,
      },
    ];
---

<div
  class:list={[
    'feature-card -mx-4 grid border-y-4 border-ink md:mx-0 md:border-4',
    hero ? 'feature-card--hero' : 'lg:grid-cols-12',
    className,
  ]}
>
  <div
    class:list={[
      'feature-sash flex min-w-0 flex-col bg-limestone px-4 py-5 md:p-6 lg:p-8 xl:p-10',
      !hero && spans.sash,
    ]}
  >
    <slot />
  </div>
  <div
    class:list={[
      // content-box: the aspect ratio applies to the photo area, not photo + mullion.
      'feature-pane relative box-content border-t-4 border-ink bg-ink',
      hero
        ? 'aspect-4/3 md:border-t-0 md:border-l-4'
        : [
            'min-w-0',
            portrait ? 'aspect-3/4' : 'aspect-4/3',
            'lg:self-stretch lg:justify-self-stretch lg:border-t-0 lg:border-l-4',
            spans.pane,
          ],
    ]}
  >
    <ArtDirectedPicture src={photo.src} alt={photo.alt} position={photo.position} priority={priority} class="absolute inset-0 h-full" sources={sources} />
  </div>
</div>

<style>
  .feature-sash {
    container-type: inline-size;
  }

  /*
   * Hero: from 768 px the photo pane sizes itself from the viewport so the whole
   * frame fits on the first screen (header 5rem + top padding + frame + a peek of
   * what follows = 10rem), and never wider than 7 of the 12 content columns.
   * Content width = viewport (capped at 80rem) minus the page gutters.
   */
  @media (width >= 48rem) {
    .feature-card--hero {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .feature-card--hero .feature-pane {
      height: min(calc((100vw - 3rem) * 0.4375), calc(100svh - 10rem));
      aspect-ratio: 4 / 3;
    }
  }
  @media (width >= 64rem) {
    .feature-card--hero .feature-pane {
      height: min(calc((min(100vw, 80rem) - 4rem) * 0.4375), calc(100svh - 10rem));
    }
  }
</style>
