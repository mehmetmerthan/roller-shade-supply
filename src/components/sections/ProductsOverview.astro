---
/**
 * [PRODUCTS]: three product cards (elevation drawings, not project photos, so no
 * card implies proof we don't have), each linking to the quote form with its product
 * prefilled; the four approved operating options as a ruled row; and the approved
 * availability qualifier.
 */
import ProductCard from '../ui/ProductCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { products } from '../../copy/approved';
import { catalogPage, homeSections } from '../../config/nav';
import { quoteHref } from '../../lib/quote';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { id } = homeSections.products;
---

<section id={id} data-home-section aria-labelledby={`${id}-title`} class:list={['page-gutter mx-auto max-w-content', className]}>
  <SectionHeading id={`${id}-title`} title={products.title} intro={products.intro} />

  <ul class="mt-8 grid gap-10 md:grid-cols-3 md:gap-6 lg:mt-10 lg:gap-8">
    {
      products.items.map((item) => (
        <li class="flex">
          {/* TODO(content): "Get Pricing for {Product}" is draft microcopy (additional-content §10). */}
          <ProductCard
            product={item.product}
            title={item.title}
            description={item.description}
            href={quoteHref({ product: item.product })}
            ctaLabel={`Get Pricing for ${item.title}`}
            class="w-full"
          />
        </li>
      ))
    }
  </ul>

  {/* The sub-heading sits in the sash column from 1280 px (too narrow below that). */}
  <div class="mt-12 grid gap-4 lg:mt-16 xl:grid-cols-12 xl:gap-8">
    <h3 class="text-xl xl:col-span-2 xl:pt-4">{products.operatingIntro}</h3>
    <ul class="grid gap-px border-y border-ink bg-line sm:grid-cols-2 lg:grid-cols-4 xl:col-span-10">
      {products.operatingOptions.map((option) => <li class="flex min-h-16 items-center bg-paper px-4 py-3 font-semibold lg:px-5">{option}</li>)}
    </ul>
    <p class="text-sm text-stone-700 xl:col-span-10 xl:col-start-3">{products.note}</p>
    {/* TODO(content): "Browse Fabric Catalogs" is new microcopy. */}
    <p class="mt-2 xl:col-span-10 xl:col-start-3">
      <a href={catalogPage.href} class="btn btn-secondary">Browse Fabric Catalogs</a>
    </p>
  </div>
</section>
