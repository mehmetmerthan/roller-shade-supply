---
/**
 * [GOVERNMENT] on an ink band: the approved heading beside the two approved
 * paragraphs, a typographic pause between the ruled tables around it.
 */
import { government } from '../../copy/approved';
import { homeSections } from '../../config/nav';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { id } = homeSections.publicSector;
const [lead, second] = government.paragraphs;
// Keep "Public-Sector" on one line: a break after the hyphen reads as a typo.
const titleParts = government.title.split(/(\S+-\S+)/).filter(Boolean);
---

<section
  id={id}
  data-home-section
  aria-labelledby={`${id}-title`}
  data-surface="dark"
  class:list={['bg-ink py-section text-paper lg:py-section-lg', className]}
>
  <div class="page-gutter mx-auto max-w-content">
    <div class="grid gap-6 border-t-4 border-paper pt-4 lg:grid-cols-12 lg:gap-8 lg:pt-6">
      <h2 id={`${id}-title`} class="text-3xl lg:col-span-5">
        {titleParts.map((part) => (/-/.test(part) && !/\s/.test(part) ? <span class="whitespace-nowrap">{part}</span> : part))}
      </h2>
      <div class="max-w-prose space-y-4 lg:col-span-6 lg:col-start-7 lg:pt-2">
        <p class="text-lg">{lead}</p>
        <p class="text-stone-200">{second}</p>
      </div>
    </div>
  </div>
</section>
