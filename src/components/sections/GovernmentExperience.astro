---
/**
 * [GOVERNMENT] on an ink band: the approved copy, then a ruled list of the school and
 * public-sector projects (each links to its page) and the two industry pages.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { government } from '../../copy/approved';
import { isProduction } from '../../config/site';
import { industryLabels, industrySlugs } from '../../config/taxonomy';
import { projectHref, type Project } from '../../lib/projects';

interface Props {
  /** Projects in the education sector or the government industry. */
  projects: Project[];
  class?: string;
}

const { projects, class: className } = Astro.props;
// Staging only: one note instead of a badge on every row.
const showSampleNote = !isProduction && projects.some((p) => p.data.placeholder);
---

<section aria-labelledby="government" data-surface="dark" class:list={['bg-ink py-section text-paper lg:py-section-lg', className]}>
  <div class="page-gutter mx-auto max-w-content">
    <SectionHeading id="government" title={government.title} intro={government.paragraphs[0]} surface="dark">
      <p class="mt-3 max-w-prose text-stone-200">{government.paragraphs[1]}</p>
    </SectionHeading>

    <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12">
      <div class="lg:col-span-8 lg:col-start-3">
        <h3 id="government-projects" class="label-spec pb-3 text-stone-300">School and public-sector projects</h3>
        <ul aria-labelledby="government-projects" class="border-t border-paper">
          {
            projects.map((project) => (
              <li class="grid gap-x-6 gap-y-0.5 border-b border-stone-700 py-3 sm:grid-cols-[1fr_auto]">
                <a href={projectHref(project)} class="link-quiet inline-flex min-h-6 items-center justify-self-start font-semibold">
                  {project.data.title}
                </a>
                <span class="text-sm text-stone-300 sm:text-right sm:text-base">{project.data.location}</span>
              </li>
            ))
          }
        </ul>
        {
          showSampleNote && (
            <p class="mt-3 text-sm text-stone-300">These projects are sample write-ups until their details are confirmed.</p>
          )
        }
      </div>

      <nav aria-labelledby="government-industries" class="lg:col-span-2">
        <h3 id="government-industries" class="label-spec pb-3 text-stone-300">Industry pages</h3>
        <ul class="border-t border-paper">
          {
            (['education', 'government'] as const).map((industry) => (
              <li class="border-b border-stone-700">
                <a href={`/industries/${industrySlugs[industry]}/`} class="link flex min-h-12 items-center py-2 font-semibold">
                  {industryLabels[industry]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</section>
