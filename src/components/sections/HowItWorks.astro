---
/**
 * How it works (§4, placeholder) on a limestone band. A real sequence, so it is an
 * ordered list and the steps are numbered.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { processSteps } from '../../copy/placeholder';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section aria-labelledby="how-it-works" class:list={['bg-limestone py-section lg:py-section-lg', className]}>
  <div class="page-gutter mx-auto max-w-content">
    <SectionHeading id="how-it-works" title="How It Works" />
    <ol class="mt-8 grid gap-8 md:grid-cols-2 lg:mt-10 lg:grid-cols-4">
      {
        processSteps.map((step, i) => (
          <li class="border-t border-ink pt-4">
            <p class="font-display text-3xl font-extrabold" aria-hidden="true">
              {i + 1}
            </p>
            <h3 class="mt-4 text-xl">
              <span class="sr-only">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-2 text-ink">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
