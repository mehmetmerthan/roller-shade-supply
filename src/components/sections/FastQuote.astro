---
/**
 * [FAST-QUOTE]: the checklist beside the approved example request, read back as a
 * filled-in form against the checklist, then the measurement note and the CTA.
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { fastQuote } from '../../copy/approved';
import { exampleBreakdown } from '../../copy/placeholder';
import { quoteCta } from '../../config/nav';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section aria-labelledby="fast-quote" class:list={['page-gutter mx-auto max-w-content', className]}>
  <SectionHeading id="fast-quote" title={fastQuote.title} intro={fastQuote.intro} />

  <div class="mt-8 grid gap-10 lg:mt-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4 lg:col-start-3">
      <h3 class="text-xl">{fastQuote.checklistIntro}</h3>
      <ul class="mt-3 border-t border-ink">
        {
          fastQuote.checklist.map((item) => (
            <li class="flex items-center gap-3 border-b border-line py-2.5">
              <Icon name="check" size={20} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="border-t-4 border-ink bg-stone-50 p-5 lg:col-span-6 lg:p-8">
      <figcaption class="label-spec">{fastQuote.exampleTitle}</figcaption>
      <blockquote class="mt-3 font-display text-2xl font-bold">
        <p>“{fastQuote.example}”</p>
      </blockquote>
      {/* The example read back as a filled-in form: one cell per checklist item. */}
      <dl class="mt-6 grid grid-cols-2 gap-px border-y border-ink bg-line sm:grid-cols-3">
        {
          exampleBreakdown.map((item) => (
            <div class="bg-stone-50 px-3 py-3">
              <dt class="label-spec">{item.label}</dt>
              <dd class="mt-0.5 text-sm font-semibold">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </figure>

    <div class="flex flex-col gap-6 lg:col-span-10 lg:col-start-3 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
      <p class="max-w-prose text-stone-700">{fastQuote.measurementNote}</p>
      <Button href={quoteCta.href} size="lg" class="shrink-0">{quoteCta.label}</Button>
    </div>
  </div>
</section>
