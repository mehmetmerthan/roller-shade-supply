---
/**
 * Quote form, kept short at the client's request (11/11/2026): Name and Email
 * (required), Phone, an optional message, and a file upload.
 *
 * Backend: Netlify Forms through src/lib/forms.ts (a normal multipart POST; success
 * shows /request-a-quote/thank-you/). Works without JS through native validation.
 *
 * With JS:
 *   - inline errors plus an error summary on submit (src/lib/form-validation.ts);
 *   - links like /request-a-quote/?product=zebra-shades&projectType=school
 *     (src/lib/quote.ts) fill two hidden fields, so the request still says which
 *     product and project type the visitor came from;
 *   - one submit per page load ("Sending your request…").
 */
import Button from '../ui/Button.astro';
import AlertIcon from '../ui/form/AlertIcon.astro';
import FileField from '../ui/form/FileField.astro';
import TextField from '../ui/form/TextField.astro';
import { contact, quoteFields as f } from '../../copy/approved';
import { quoteFormCopy as c } from '../../copy/placeholder';
import { legalLinks } from '../../config/nav';
import { PRODUCTS } from '../../config/taxonomy';
import {
  HONEYPOT_FIELD,
  UPLOAD_ACCEPT,
  UPLOAD_MAX_BYTES,
  formAttributes,
  hiddenFields,
  quoteForm,
} from '../../lib/forms';
import { QUOTE_PROJECT_TYPES } from '../../lib/quote';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Query-string keys → the approved option labels, stored in the hidden fields.
const productKeys = [...PRODUCTS, 'not-sure', 'other'];
const productMap = Object.fromEntries(f.product.options.map((label, i) => [productKeys[i], label]));
const projectTypeMap: Record<string, string> = { ...QUOTE_PROJECT_TYPES };

const privacy = legalLinks.find((l) => l.href === '/privacy-policy/')!;
---

<form
  {...formAttributes(quoteForm)}
  class:list={['quote-form border-t-4 border-ink pt-6', className]}
  aria-labelledby="quote-form-title"
  data-quote-form
>
  <h2 id="quote-form-title" class="sr-only">Quote request form</h2>
  {hiddenFields(quoteForm).map((field) => <input type="hidden" name={field.name} value={field.value} />)}
  <input type="hidden" name="product" data-prefill="product" data-map={JSON.stringify(productMap)} />
  <input type="hidden" name="project_type" data-prefill="projectType" data-map={JSON.stringify(projectTypeMap)} />
  <p class="hidden">
    <label>
      Don’t fill this out if you’re human:
      <input name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="error-summary mb-8" tabindex="-1" role="alert" aria-labelledby="quote-errors-title" data-error-summary hidden>
    <h2 id="quote-errors-title" class="flex items-center gap-2 font-sans text-base font-bold tracking-normal">
      <AlertIcon class="text-error" size={18} />
      Please fix the following before submitting:
    </h2>
    <ul class="mt-2 list-disc pl-10"></ul>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <TextField id="name" label={f.name} required autocomplete="name" messages={{ required: c.errors.name }} />
    <TextField
      id="email"
      label={f.email}
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      messages={{ required: c.errors.email, format: c.errors.emailFormat }}
    />
    <TextField id="phone" label={c.phone} type="tel" autocomplete="tel" inputmode="tel" />
    <TextField id="details" label={f.details.label} type="textarea" rows={5} hint={f.details.hint} class="sm:col-span-2" />
    <FileField
      id="upload"
      label={f.upload}
      accept={UPLOAD_ACCEPT}
      maxBytes={UPLOAD_MAX_BYTES}
      hint={c.uploadHint}
      messages={{ size: c.errors.fileSize, type: c.errors.fileType }}
      class="sm:col-span-2"
    />
  </div>

  <div class="mt-10 border-t border-ink pt-6">
    <Button type="submit" size="lg" class="w-full sm:w-auto" data-submit>{contact.submitLabel}</Button>
    <p class="mt-3 text-sm font-semibold" role="status" data-form-status></p>
    <p class="mt-3 max-w-prose text-sm text-stone-700">
      {contact.responseNote}
      {' '}{c.privacy}{' '}
      <a href={privacy.href} class="link-quiet inline-block py-0.5">{c.privacyLink}</a>
    </p>
  </div>
</form>

<script>
  import { setError, showSummary, validateControl, validateForm } from '../../lib/form-validation';
  import { devStub } from '../../lib/forms';
  import { quoteFormCopy } from '../../copy/placeholder';

  const form = document.querySelector<HTMLFormElement>('form[data-quote-form]');
  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    form.noValidate = true;

    // ---- Context from the link that brought the visitor here (src/lib/quote.ts) ----
    const params = new URLSearchParams(location.search);
    for (const input of form.querySelectorAll<HTMLInputElement>('input[data-prefill]')) {
      const key = params.get(input.dataset.prefill!);
      const map = JSON.parse(input.dataset.map ?? '{}') as Record<string, string>;
      if (key && map[key]) input.value = map[key];
    }

    // ---- Validation and submit ----
    let attempted = false;
    let submitting = false;
    for (const control of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-validate]')) {
      const isFile = control instanceof HTMLInputElement && control.type === 'file';
      // Files are checked as soon as they're chosen; other fields after the first submit.
      control.addEventListener(isFile ? 'change' : 'input', () => {
        if (isFile || attempted) setError(control, validateControl(control));
      });
    }

    form.addEventListener('submit', (e) => {
      if (submitting) {
        e.preventDefault();
        return;
      }
      const errors = validateForm(form);
      if (errors.length > 0) {
        e.preventDefault();
        attempted = true;
        showSummary(summary, errors);
        return;
      }
      summary.hidden = true;
      submitting = true;
      submit.setAttribute('aria-disabled', 'true');
      status.textContent = quoteFormCopy.sending;
      if (devStub) {
        // `astro dev` has no form backend: go straight to the thank-you page.
        e.preventDefault();
        location.assign(form.action);
      }
    });

    // Back from the thank-you page (bfcache): allow a new submission.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      submitting = false;
      submit.removeAttribute('aria-disabled');
      status.textContent = '';
    });
  }
</script>
