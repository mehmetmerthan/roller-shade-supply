---
/**
 * [WHO-WE-ARE] on the standard card (FeatureCard): the approved heading, paragraphs,
 * and union statement on the limestone sash; a portrait project photo in the pane.
 * A caption under the frame links to the project the photo comes from.
 */
import FeatureCard from '../ui/FeatureCard.astro';
import { whoWeAre } from '../../copy/approved';
import { homeSections } from '../../config/nav';
import { projectHref, type Project, type ProjectPhoto } from '../../lib/projects';

interface Props {
  photo: ProjectPhoto;
  project: Project;
  class?: string;
}

const { photo, project, class: className } = Astro.props;
const { id } = homeSections.whoWeAre;
const [lead, ...rest] = whoWeAre.paragraphs;
const union = rest.at(-1);
const body = rest.slice(0, -1);
---

<section id={id} data-home-section aria-labelledby={`${id}-title`} class:list={['page-gutter mx-auto max-w-content', className]}>
  <FeatureCard photo={photo} sashSpan={7}>
    <h2 id={`${id}-title`} class="text-3xl">{whoWeAre.title}</h2>
    <div class="mt-4 max-w-prose space-y-4 lg:mt-6">
      <p class="text-lg">{lead}</p>
      {body.map((p) => <p class="text-stone-700">{p}</p>)}
    </div>
    {/* From 1024 px the union statement sits on the sash's base, like the hero's title block. */}
    {
      union && (
        <div class="mt-6 lg:mt-auto lg:pt-8">
          <p class="max-w-prose border-l-4 border-ink pl-4 font-semibold">{union}</p>
        </div>
      )
    }
  </FeatureCard>
  <p class="mt-2 text-sm text-stone-700 lg:text-right">
    <a href={projectHref(project)} class="link-quiet inline-flex min-h-6 items-center">{project.data.title}</a>
  </p>
</section>
