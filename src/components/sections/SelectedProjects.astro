---
/**
 * [PROJECTS] on Home: the featured projects (sorted by `order`) in a carousel,
 * then "View Project Gallery".
 */
import Button from '../ui/Button.astro';
import ProjectCarousel from '../ui/ProjectCarousel.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { selectedProjects } from '../../copy/approved';
import type { Project } from '../../lib/projects';

interface Props {
  featured: Project[];
  /** All live projects, for the gallery count. */
  totalProjects: number;
  class?: string;
}

const { featured, totalProjects, class: className } = Astro.props;
---

<section aria-labelledby="selected-projects" class:list={['page-gutter mx-auto max-w-content', className]}>
  <SectionHeading id="selected-projects" title={selectedProjects.title} intro={selectedProjects.paragraphs[0]}>
    <p class="mt-3 max-w-prose text-stone-700">{selectedProjects.paragraphs[1]}</p>
  </SectionHeading>
  <ProjectCarousel id="featured-projects" label="Featured projects" projects={featured} class="mt-8 lg:mt-10">
    <Fragment slot="actions">
      <Button href="/projects/" variant="secondary">{selectedProjects.cta}</Button>
      <p class="text-sm text-stone-700">{totalProjects} projects in the gallery</p>
    </Fragment>
  </ProjectCarousel>
</section>
