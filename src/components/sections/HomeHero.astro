---
/**
 * Home introduction: the standard card (FeatureCard, hero variant) as an architectural
 * title block. The limestone sash carries the approved kicker at the top and the H1
 * on its base; the pane shows the whole hero photo, uncropped. The frame is sized
 * to the viewport so the heading and the complete photo are on the first screen.
 *
 * The approved [HERO] paragraphs and CTAs are no longer shown (client request,
 * 11/11/2026): Who We Are, the header, and the contact band carry that content.
 */
import FeatureCard from '../ui/FeatureCard.astro';
import { hero } from '../../copy/approved';
import { getCover, type Project } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const photo = getCover(project);
---

<section aria-labelledby="hero-title" class="page-gutter mx-auto max-w-content pt-6 md:pt-8 lg:pt-10">
  <FeatureCard photo={photo} variant="hero" priority>
    <div class="flex flex-1 flex-col justify-between gap-3 md:gap-8">
      <p class="text-sm font-semibold text-stone-700 md:text-base">{hero.kicker}</p>
      <h1 id="hero-title" class="hero-title">{hero.title}</h1>
    </div>
  </FeatureCard>
</section>

<style>
  /* Sized to the sash (a size container): ~4 lines on phones, a tall title block beside the photo. */
  .hero-title {
    font-size: clamp(2rem, 10cqi, 3rem);
    line-height: 0.95;
  }
  @media (width >= 48rem) {
    .hero-title {
      font-size: clamp(2.25rem, 12cqi, 4.5rem);
    }
  }
</style>
