---
/**
 * Home introduction (approved [HERO] heading and paragraphs) as one Chicago-window
 * frame:
 *
 *   ≥ 1024 px  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
 *              ┃ H1 across the full width (2 lines)    ┃  limestone band (the transom)
 *              ┣━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━┫
 *              ┃ the two paragraphs┃  whole photo (4:3) ┃  limestone | photo
 *              ┗━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━┛
 *   < 1024 px  H1 band → photo → paragraphs, so the heading and the whole photo
 *              are on the first screen (the text may run below the fold).
 *
 * The photo is never cropped. From 1024 px its height is the smaller of
 * "7/12 of the content width × 3/4" and "what's left of the viewport under the
 * header and the H1 band", so the H1 and the complete photo always load together.
 * The H1 size is one custom property (--hero-h1) shared by the heading and that
 * calculation. The kicker and the hero buttons are not shown (client request,
 * 11/11/2026).
 */
import ArtDirectedPicture from '../ui/ArtDirectedPicture.astro';
import { hero } from '../../copy/approved';
import { getCover, type Project } from '../../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const photo = getCover(project);
if (photo.src.height > photo.src.width) throw new Error('HomeHero: the hero photo must be landscape (4:3).');
const [lead, second] = hero.paragraphs;
---

<section aria-labelledby="hero-title" class="page-gutter mx-auto max-w-content pt-6 md:pt-8 lg:pt-10">
  <div class="hero-frame">
    <div class="hero-band">
      <h1 id="hero-title" class="hero-title">{hero.title}</h1>
    </div>
    <div class="hero-photo">
      <ArtDirectedPicture
        src={photo.src}
        alt={photo.alt}
        position={photo.position}
        priority
        class="absolute inset-0 h-full"
        sources={[
          {
            width: 2048,
            height: 1536,
            widths: [480, 640, 800, 1024, 1280, 1600, 2048],
            sizes: '(min-width: 80rem) 720px, (min-width: 64rem) 58vw, 100vw',
          },
        ]}
      />
    </div>
    <div class="hero-text">
      <p class="text-lg lg:text-base xl:max-w-prose xl:text-lg">{lead}</p>
      <p class="text-stone-700 lg:text-sm xl:max-w-prose xl:text-base">{second}</p>
    </div>
  </div>
</section>

<style>
  .hero-frame {
    /* One size for the H1, also used below to leave room for the band. */
    --hero-h1: clamp(2rem, 1rem + 2.8vw, 3.5rem);
    /* A size container, so the photo can be sized from the frame's real width (cqi)
       instead of the viewport, which on some systems includes the scrollbar. */
    container-type: inline-size;
    display: grid;
    grid-template-areas: "band" "photo" "text";
    margin-inline: -1rem;
    border-block: 4px solid var(--color-ink);
    background: var(--color-limestone);
  }
  .hero-band {
    grid-area: band;
    padding: 1.25rem 1rem;
    border-bottom: 4px solid var(--color-ink);
  }
  .hero-title {
    font-size: var(--hero-h1);
    line-height: 0.95;
  }
  .hero-photo {
    grid-area: photo;
    position: relative;
    /* content-box: 4:3 is the photo area itself, so the photo is never cropped. */
    box-sizing: content-box;
    aspect-ratio: 4 / 3;
    background: var(--color-ink);
  }
  .hero-text {
    grid-area: text;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.25rem 1rem 1.5rem;
    border-top: 4px solid var(--color-ink);
  }

  @media (width >= 48rem) {
    .hero-frame {
      margin-inline: 0;
      border: 4px solid var(--color-ink);
    }
    .hero-band {
      padding: 1.5rem;
    }
    .hero-text {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }

  @media (width >= 64rem) {
    .hero-frame {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "band band"
        "text photo";
    }
    .hero-band {
      /* 3.5rem of vertical padding: part of the 12.75rem in the photo height below. */
      padding: 1.75rem 2rem;
    }
    .hero-photo {
      align-self: start;
      border-left: 4px solid var(--color-ink);
      /* A mullion under the photo: hidden by the frame when they're flush, visible if
         the text column ever runs longer (e.g., zoomed text). */
      box-shadow: 0 4px 0 var(--color-ink);
      /*
       * Never wider than 7/12 of the frame (7/12 × 3/4 = 43.75cqi of height); never
       * taller than what's left of the viewport after the header (5rem), top padding
       * (2.5rem), the frame and mullions (0.75rem), the band's padding (3.5rem), a
       * 1rem peek of what follows, and the two-line H1 (2 × 0.95 × --hero-h1).
       */
      height: min(43.75cqi, calc(100svh - 12.75rem - 1.9 * var(--hero-h1)));
    }
    .hero-text {
      grid-template-columns: none;
      gap: 1rem;
      padding: 2rem;
      border-top: 0;
    }
  }

  @media (width >= 80rem) {
    .hero-band {
      padding-inline: 2.5rem;
    }
    .hero-text {
      gap: 1.25rem;
      padding: 2rem 2.5rem;
    }
  }
</style>
