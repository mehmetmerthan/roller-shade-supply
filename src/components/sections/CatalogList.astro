---
/**
 * The fabric catalogs (src/lib/catalogs.ts), one ruled entry each: the cover (page 1)
 * in a steel frame beside the title, what's inside, a spec table (product, pages, file
 * size), View Catalog, Download PDF, and a prefilled quote link.
 *
 * The PDFs are large (~40 MB), so nothing heavy loads until someone asks for it:
 *   - View Catalog: on desktop browsers that can show PDFs inline
 *     (navigator.pdfViewerEnabled and a fine pointer, from 768 px), the PDF opens in a
 *     full-screen <dialog> with the browser's own viewer (pages, zoom, print), a
 *     Download button, and Close (Esc works; focus returns to the button). Phones,
 *     browsers without an inline viewer, and no-JS visitors get a normal link that
 *     opens the PDF in a new tab (the device's own viewer). The PDFs are linearized,
 *     so the first pages show before the whole file arrives.
 *   - Download PDF: a same-origin `download` link with the file size on the button.
 */
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import ProductElevation from '../ui/ProductElevation.astro';
import SpecList from '../ui/SpecList.astro';
import { productLabels } from '../../config/taxonomy';
import type { Catalog } from '../../lib/catalogs';
import { quoteHref } from '../../lib/quote';

interface Props {
  catalogs: Catalog[];
  class?: string;
}

const { catalogs, class: className } = Astro.props;
---

<ol class:list={['space-y-16 lg:space-y-20', className]}>
  {
    catalogs.map((c, i) => {
      const titleId = `catalog-${c.slug}`;
      const view = { 'data-catalog-view': '', 'data-title': c.title, 'data-download-name': c.downloadName };
      return (
        <li>
          <article aria-labelledby={titleId} class="grid gap-6 border-t-4 border-ink pt-6 lg:grid-cols-12 lg:gap-8 lg:pt-8">
            {/* The cover repeats View Catalog for pointer users; hidden from keyboard and screen readers. */}
            <a href={c.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" class="catalog-cover block self-start lg:col-span-7" {...view}>
              {c.cover ? (
                <Picture
                  src={c.cover}
                  alt=""
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1280px) 700px, (min-width: 1024px) 57vw, 100vw"
                  formats={['avif', 'webp']}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="block h-auto w-full"
                />
              ) : (
                <div class="bg-limestone px-10 py-8">
                  <ProductElevation product={c.product} />
                </div>
              )}
            </a>
            <div class="flex flex-col lg:col-span-5">
              <h2 id={titleId} class="text-2xl lg:text-3xl">
                {c.title}
              </h2>
              <p class="mt-3 max-w-prose text-stone-700">{c.description}</p>
              <SpecList
                class="mt-5"
                items={[
                  { label: 'Product', value: productLabels[c.product] },
                  { label: 'Pages', value: String(c.pages) },
                  { label: 'File', value: `PDF, ${c.size}` },
                ]}
              />
              <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:mt-auto lg:pt-8">
                <a href={c.href} target="_blank" rel="noopener" class="btn btn-primary" {...view}>
                  View Catalog
                  <span class="sr-only" data-view-hint>
                    (PDF, opens in a new tab)
                  </span>
                </a>
                <a href={c.href} download={c.downloadName} class="btn btn-secondary">
                  <Icon name="download" />
                  Download PDF
                  <span class="font-normal">({c.size})</span>
                </a>
              </div>
              <p class="mt-4 text-sm">
                <a href={quoteHref({ product: c.product })} class="link inline-flex min-h-6 items-center">
                  {`Get Pricing for ${productLabels[c.product]}`}
                </a>
              </p>
            </div>
          </article>
        </li>
      );
    })
  }
</ol>

<dialog class="catalog-viewer" aria-labelledby="catalog-viewer-title" data-catalog-viewer>
  <div class="flex h-full flex-col">
    <div data-surface="dark" class="flex min-h-16 flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 md:px-6">
      <p id="catalog-viewer-title" class="mr-auto min-w-0 truncate font-display text-xl font-extrabold" data-viewer-title></p>
      <a href="#" download class="btn btn-secondary btn-sm" data-viewer-download>
        <Icon name="download" size={16} />
        Download PDF
      </a>
      <button type="button" class="btn btn-ghost btn-sm min-h-12 gap-2" data-viewer-close autofocus>
        Close
        <Icon name="close" />
      </button>
    </div>
    <iframe class="min-h-0 w-full flex-1 border-0 bg-stone-200" title="Catalog" data-viewer-frame></iframe>
  </div>
</dialog>

<style>
  .catalog-cover {
    border: 4px solid var(--color-ink);
    background: var(--color-ink);
  }
  .catalog-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-ink);
  }
  .catalog-viewer::backdrop {
    background: var(--color-ink);
  }
  :global(html:has(.catalog-viewer[open])) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-catalog-viewer]');
  // Inline viewing only where the browser shows PDFs itself and the screen is a desktop
  // one; everywhere else the links open the PDF in a new tab (the device's viewer).
  const inline =
    navigator.pdfViewerEnabled === true && window.matchMedia('(min-width: 48rem) and (pointer: fine)').matches;

  if (dialog && inline) {
    const frame = dialog.querySelector<HTMLIFrameElement>('[data-viewer-frame]')!;
    const title = dialog.querySelector<HTMLElement>('[data-viewer-title]')!;
    const download = dialog.querySelector<HTMLAnchorElement>('[data-viewer-download]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]')!;
    let returnTo: HTMLElement | null = null;

    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-catalog-view]')) {
      const hint = link.querySelector('[data-view-hint]');
      if (hint) hint.textContent = '(PDF)';
      link.addEventListener('click', (e) => {
        // Let modified clicks (new tab / window) and middle clicks do their usual thing.
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const name = link.dataset.title ?? '';
        title.textContent = name;
        frame.title = `${name} (PDF)`;
        frame.src = link.href;
        download.href = link.href;
        download.download = link.dataset.downloadName ?? '';
        // Focus goes back to the entry's View Catalog button, even when the cover was clicked.
        returnTo = link.closest('article')?.querySelector<HTMLElement>('.btn[data-catalog-view]') ?? link;
        dialog.showModal();
      });
    }
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      frame.src = 'about:blank';
      returnTo?.focus({ preventScroll: true });
    });
  }
</script>
