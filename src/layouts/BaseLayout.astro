---
/**
 * Base document: SEO head (title, description, robots, canonical, Open Graph, Twitter,
 * JSON-LD), fonts, skip link, header, footer, and the mobile action bar.
 * Staging builds are always noindex (see SITE_ENV in src/config/site.ts).
 */
// Package roots resolve to the variable `wght` axis CSS (see each package's exports map).
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import textFont from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import { isProduction, site } from '../config/site';
import { homePhotos } from '../config/home';
import { getCover, getProjects } from '../lib/projects';
import { serializeJsonLd, type JsonLd } from '../lib/seo';

interface Props {
  /** Page title; the brand suffix is added unless `fullTitle` is set. */
  title: string;
  description?: string;
  /** Always noindex (e.g., styleguide, thank-you pages). Staging builds are noindex regardless. */
  noindex?: boolean;
  fullTitle?: boolean;
  /** Open Graph image (cropped to 1200 × 630). Defaults to the home hero photo. */
  ogImage?: { src: ImageMetadata; alt: string; position?: string };
  ogType?: 'website' | 'article';
  /** JSON-LD nodes for this page (combined into one @graph). */
  jsonLd?: JsonLd[];
  /** Hide the phone action bar (e.g., on the quote form itself). */
  actionBar?: boolean;
}

const {
  title,
  description = site.description,
  noindex = false,
  fullTitle = false,
  ogImage,
  ogType = 'website',
  jsonLd = [],
  actionBar = true,
} = Astro.props;

const documentTitle = fullTitle ? title : `${title} | ${site.name}`;
const robots = noindex || !isProduction ? 'noindex, nofollow' : 'index, follow';
const canonical = new URL(Astro.url.pathname, site.url).href;

// TODO(content): a branded 1200 × 630 card (logo + tagline) replaces this default in Phase 8.
let og = ogImage;
if (!og) {
  const hero = (await getProjects()).find((p) => p.id === homePhotos.heroProject);
  if (hero) og = getCover(hero);
}
const ogRendered = og
  ? await getImage({ src: og.src, width: 1200, height: 630, fit: 'cover', position: og.position, format: 'jpg' })
  : undefined;
const ogUrl = ogRendered ? new URL(ogRendered.src, site.url).href : undefined;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      ogUrl && og && (
        <>
          <meta property="og:image" content={ogUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={og.alt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <!-- TODO(content): placeholder favicon from the placeholder logo mark; full set in Phase 8. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', actionBar && 'pb-16 md:pb-0']}>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
    {actionBar && <MobileActionBar />}
  </body>
</html>
