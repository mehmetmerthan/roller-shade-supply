---
/*
 * /styleguide/ — internal design-system reference (Direction B "Chicago Window").
 * noindex, excluded from the sitemap (astro.config.mjs). Remove or block before launch.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ChicagoWindow from '../components/ui/ChicagoWindow.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SpecList from '../components/ui/SpecList.astro';
import ChoiceGroup from '../components/ui/form/ChoiceGroup.astro';
import ErrorSummary from '../components/ui/form/ErrorSummary.astro';
import SelectField from '../components/ui/form/SelectField.astro';
import TextField from '../components/ui/form/TextField.astro';
import { site } from '../config/site';
import { quoteCta } from '../config/nav';
import { getCover, getProjects, projectHref } from '../lib/projects';

const projects = await getProjects();
const bySlug = (id: string) => {
  const p = projects.find((x) => x.id === id);
  if (!p) throw new Error(`Styleguide: project "${id}" not found.`);
  return p;
};
const sampleCards = ['water-power-lofts-rockford', 'sris-international-school', 'mosque'].map(bySlug);
// Sample section: SRIS shows the product unmistakably at 16:9 (2560 px client photo).
const heroProject = bySlug('sris-international-school');
const heroPhoto = getCover(heroProject);
const badgePhoto = getCover(bySlug('mosque'));

const sections = [
  ['color', 'Color'],
  ['type', 'Type'],
  ['spacing', 'Spacing'],
  ['buttons', 'Buttons'],
  ['links', 'Links'],
  ['forms', 'Form fields'],
  ['badges', 'Badges and labels'],
  ['headings', 'Section headings'],
  ['cards', 'Cards'],
  ['window', 'Chicago window'],
  ['sample', 'Sample section'],
] as const;

const colors = [
  { token: 'paper', hex: '#F2F2EF', role: 'Page background (vellum)', note: 'Ink on paper 14.60:1', swatch: 'bg-paper' },
  { token: 'limestone', hex: '#DDD6C8', role: 'Bands, spec panels, sashes', note: 'Ink 11.33:1. No red text', swatch: 'bg-limestone' },
  { token: 'ink', hex: '#1C2025', role: 'Text, mullions, footer', note: 'Paper on ink 14.60:1', swatch: 'bg-ink' },
  { token: 'accent', hex: '#B3261E', role: 'Redline: CTAs and links only', note: 'White on it 6.54:1. On paper 5.83:1', swatch: 'bg-accent' },
  { token: 'accent-hover', hex: '#8F1D17', role: 'Pressed and hover state', note: 'White on it 8.91:1', swatch: 'bg-accent-hover' },
  { token: 'error', hex: '#9D174D', role: 'Errors only. Never a fill', note: 'On paper 7.03:1', swatch: 'bg-error' },
  { token: 'error-tint', hex: '#F9E8EE', role: 'Error summary background', note: 'Ink on it 13.88:1', swatch: 'bg-error-tint' },
  { token: 'line-strong', hex: '#7C8183', role: 'Form-field borders', note: 'On paper 3.52:1 (UI)', swatch: 'bg-line-strong' },
  { token: 'line', hex: '#C8CBC8', role: 'Decorative rules', note: '1.46:1, decorative only', swatch: 'bg-line' },
];

const stones = [
  ['50', '#F7F7F5', 'bg-stone-50'],
  ['100', '#E6E7E4', 'bg-stone-100'],
  ['200', '#C8CBC8', 'bg-stone-200'],
  ['300', '#A9ADAC', 'bg-stone-300'],
  ['400', '#8A8F90', 'bg-stone-400'],
  ['500', '#6E7375', 'bg-stone-500'],
  ['600', '#555A5D', 'bg-stone-600'],
  ['700', '#3F4447', 'bg-stone-700'],
  ['800', '#2C3034', 'bg-stone-800'],
  ['900', '#1C2025', 'bg-stone-900'],
] as const;

const spacing = [
  ['2', '8 px', 'w-2'],
  ['4', '16 px', 'w-4'],
  ['6', '24 px', 'w-6'],
  ['8', '32 px', 'w-8'],
  ['12', '48 px', 'w-12'],
  ['16', '64 px', 'w-16'],
  ['24', '96 px', 'w-24'],
  ['32', '128 px', 'w-32'],
] as const;

const iAmA = [
  'Builder or general contractor',
  'Developer',
  'Property manager',
  'Commercial business',
  'Government or public-sector representative',
  'Architect or designer',
  'Wholesale customer',
  'Other',
].map((label) => ({ value: label, label }));

const productTypes = ['Roller shades', 'Zebra shades', 'Faux wood blinds', 'Not sure yet', 'Other'].map((label) => ({
  value: label,
  label,
}));
const unionOptions = ['Union', 'Non-union', 'Not sure'].map((label) => ({ value: label, label }));
---

<BaseLayout title="Styleguide" noindex>
  <div class="page-gutter mx-auto max-w-content pb-24 lg:pb-32">
    <!-- Title block -->
    <header class="grid gap-6 pt-10 pb-12 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-16">
      <p class="label-spec lg:col-span-2 lg:pt-4">Design system</p>
      <div class="lg:col-span-10">
        <h1 class="text-4xl">Styleguide</h1>
        <p class="mt-6 max-w-prose text-lg text-stone-700">
          Direction B, “Chicago Window”: structural steel, Indiana limestone, and the red pencil of a redline markup.
          Tokens, type, and components for the {site.name} site. Internal reference only: not indexed and not in the
          sitemap.
        </p>
        <nav aria-label="Styleguide sections" class="mt-10 max-w-3xl">
          <p class="label-spec">Contents</p>
          <ol class="mt-2 grid border-t border-ink sm:grid-cols-2 sm:gap-x-8 md:grid-cols-3">
            {
              sections.map(([id, name]) => (
                <li class="border-b border-line">
                  <a class="link-quiet block py-2.5 text-sm" href={`#${id}`}>{name}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </header>

    <!-- Color -->
    <section aria-labelledby="color" class="mt-8">
      <SectionHeading
        id="color"
        label="Color"
        title="Color tokens"
        intro="Steel, limestone, and one redline accent. Red means action. Crimson means a problem. Focus is always steel."
      />
      <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-10 lg:col-start-3">
          <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
            {
              colors.map((c) => (
                <li>
                  <div class:list={['h-20 border border-line', c.swatch]} />
                  <p class="mt-3 font-semibold">
                    {c.token} <span class="font-normal text-stone-600">{c.hex}</span>
                  </p>
                  <p class="text-sm text-stone-700">{c.role}</p>
                  <p class="text-sm text-stone-600">{c.note}</p>
                </li>
              ))
            }
          </ul>
          <h3 class="mt-12 font-sans text-base font-semibold tracking-normal">Steel greys</h3>
          <p class="mt-1 text-sm text-stone-600">Text on light surfaces uses 600 or darker. On ink, use 400 or lighter.</p>
          <ul class="mt-4 grid grid-cols-5 sm:grid-cols-10">
            {
              stones.map(([step, hex, swatch]) => (
                <li>
                  <div class:list={['h-14', swatch]} />
                  <p class="mt-2 text-sm font-semibold">{step}</p>
                  <p class="text-xs text-stone-600">{hex}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Type -->
    <section aria-labelledby="type" class="mt-20 lg:mt-28">
      <SectionHeading
        id="type"
        label="Type"
        title="Type scale"
        intro="Big Shoulders Display for headings, a condensed American gothic drawn for Chicago. Public Sans for everything you read."
      />
      <div class="mt-8 divide-y divide-line border-y border-line">
        {
          [
            {
              meta: ['H1 (text-4xl)', 'Big Shoulders 800', '48 → 112 px, leading 0.95'],
              el: <p class="font-display text-4xl font-extrabold">Commercial Window Coverings for Chicago’s Building Professionals</p>,
            },
            { meta: ['H2 (text-3xl)', 'Big Shoulders 800', '36 → 56 px, leading 1.0'], el: <p class="font-display text-3xl font-extrabold">Selected Projects</p> },
            { meta: ['H3 (text-2xl)', 'Big Shoulders 800', '28 → 36 px, leading 1.1'], el: <p class="font-display text-2xl font-extrabold">Roller Shades</p> },
            { meta: ['H4 (text-xl)', 'Big Shoulders 800', '24 px, leading 1.2'], el: <p class="font-display text-xl font-extrabold">Water Power Lofts Rockford</p> },
            {
              meta: ['Lead (text-lg)', 'Public Sans 400', '19 → 21 px, leading 1.5'],
              el: (
                <p class="max-w-prose text-lg">
                  Roller Shade Supply is a Chicago-based supplier specializing in window covering solutions for builders,
                  contractors, property managers, developers, and commercial organizations.
                </p>
              ),
            },
            {
              meta: ['Body (text-base)', 'Public Sans 400', '17 → 18 px, leading 1.6'],
              el: (
                <p class="max-w-prose">
                  We primarily serve trade and wholesale customers, providing dependable products and project support for
                  multifamily developments, commercial properties, public facilities, and other large-scale projects.
                </p>
              ),
            },
            {
              meta: ['Helper (text-sm)', 'Public Sans 400', '15 px, leading 1.5'],
              el: <p class="text-sm text-stone-700">Enter width × height in inches. Different sizes? Add a row for each, or upload a list.</p>,
            },
            { meta: ['Spec label (label-spec)', 'Public Sans 600, capitals', '13 px, tracking +0.06 em'], el: <p class="label-spec">Sector</p> },
          ].map((row) => (
            <div class="grid gap-3 py-6 lg:grid-cols-12 lg:gap-8">
              <div class="text-sm text-stone-600 lg:col-span-2">
                <p class="font-semibold text-ink">{row.meta[0]}</p>
                <p>{row.meta[1]}</p>
                <p>{row.meta[2]}</p>
              </div>
              <div class="min-w-0 lg:col-span-10">{row.el}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Spacing -->
    <section aria-labelledby="spacing" class="mt-20 lg:mt-28">
      <SectionHeading
        id="spacing"
        label="Spacing"
        title="Spacing scale"
        intro="An 8 px scale. Use even Tailwind steps only. Sections are 64 px apart on phones and 96 px on desktop; frames use 4 px mullions."
      />
      <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
        <ul class="space-y-3 lg:col-span-10 lg:col-start-3">
          {
            spacing.map(([step, px, w]) => (
              <li class="flex items-center gap-4">
                <span class="w-16 shrink-0 text-sm font-semibold">{step}</span>
                <span class:list={['h-4 bg-ink', w]} />
                <span class="text-sm text-stone-600">{px}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Buttons -->
    <section aria-labelledby="buttons" class="mt-20 lg:mt-28">
      <SectionHeading
        id="buttons"
        label="Buttons"
        title="Buttons"
        intro="Primary is the redline action, at most one per view. Secondary is a steel outline. Ghost is for quiet actions. Disabled uses a dashed border, so it never relies on color."
      />
      <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-10 lg:col-start-3">
          <div class="divide-y divide-line border-y border-line">
            {
              (['primary', 'secondary', 'ghost'] as const).map((variant) => (
                <div class="grid gap-4 py-5 md:grid-cols-5 md:items-start">
                  <h3 class="font-sans text-sm font-semibold capitalize tracking-normal md:pt-3">{variant}</h3>
                  <ul class="grid grid-cols-2 gap-x-4 gap-y-5 md:col-span-4 md:grid-cols-4">
                    {(['default', 'hover', 'focus', 'disabled'] as const).map((state) => (
                      <li>
                        <Button
                          variant={variant}
                          demo={state === 'hover' || state === 'focus' ? state : undefined}
                          disabled={state === 'disabled'}
                        >
                          Get a Quote
                        </Button>
                        <p class="label-spec mt-2">{state}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <h3 class="mt-10 font-sans text-base font-semibold tracking-normal">Sizes</h3>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <Button size="sm">Get a Quote</Button>
            <Button>Request a Quote</Button>
            <Button size="lg">Submit Quote Request</Button>
            <Button variant="secondary" href="/projects/">View Our Projects</Button>
          </div>
          <p class="mt-3 text-sm text-stone-600">Heights: 40 px (sm), 48 px (md), 56 px (lg). Touch targets are 48 px or more on phones.</p>

          <h3 class="mt-10 font-sans text-base font-semibold tracking-normal">On a dark surface</h3>
          <div data-surface="dark" class="mt-4 flex flex-wrap items-center gap-4 p-6">
            <Button href={quoteCta.href}>{quoteCta.label}</Button>
            <Button variant="secondary" href="/projects/">View Our Projects</Button>
            <Button variant="secondary" demo="focus" href="/projects/">Focused</Button>
            <Button variant="ghost" href={site.phone.href}>Call {site.phone.display}</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Links -->
    <section aria-labelledby="links" class="mt-20 lg:mt-28">
      <SectionHeading id="links" label="Links" title="Links" intro="Links in running text are redline and underlined. Quiet links are for navigation lists." />
      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="space-y-4 lg:col-span-5 lg:col-start-3">
          <p class="max-w-prose">
            Measurements should be provided as width × height. If your windows have different measurements, you may
            <a class="link" href="/request-a-quote/">upload a project schedule</a> with your request.
          </p>
          <p>
            <a class="link" data-demo="hover" href="/projects/">View Project Gallery</a>
            <span class="ml-2 text-sm text-stone-600">(hover)</span>
          </p>
          <p>
            <a class="link" data-demo="focus" href="/#fast-quote">Get a Fast Quote</a>
            <span class="ml-2 text-sm text-stone-600">(focus)</span>
          </p>
          <p><a class="link-quiet" href="/projects/">Projects</a> <span class="ml-2 text-sm text-stone-600">(quiet)</span></p>
        </div>
        <div data-surface="dark" class="self-start p-6 lg:col-span-5">
          <p class="max-w-prose">
            Roller Shade Supply is a Chicago-based window covering supplier. <a class="link" href="/#contact">Contact us</a>
            or call <a class="link" href={site.phone.href}>{site.phone.display}</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Forms -->
    <section aria-labelledby="forms" class="mt-20 lg:mt-28">
      <SectionHeading
        id="forms"
        label="Forms"
        title="Form fields"
        intro="Visible labels, “(required)” in words, hints above the field. Errors get a 2 px crimson border, an icon, and a specific message. Focus is a steel ring, so a focused field never looks like an error."
      />
      <div class="mt-8 lg:grid lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-10 lg:col-start-3">
          <ErrorSummary
            errors={[
              { href: '#sg-email-error', message: 'Please enter a valid email address, like name@company.com.' },
              { href: '#sg-about', message: 'Please tell us a little about your project.' },
            ]}
          />
          <div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
            <TextField id="sg-name" label="Name" required autocomplete="name" />
            <TextField id="sg-company" label="Company" required demo="focus" value="Lakeshore Builders" />
            <TextField
              id="sg-email-error"
              label="Email Address"
              type="email"
              required
              value="name@company"
              error="Please enter a valid email address, like name@company.com."
            />
            <TextField id="sg-location" label="Project Location" hint="City or ZIP code." value="Chicago, IL" disabled />
            <SelectField id="sg-role" label="I am a" required options={iAmA} />
            <TextField id="sg-quantity" label="Estimated Quantity" type="number" inputmode="numeric" />
            <ChoiceGroup id="sg-products" legend="Product Type" name="sg-products" options={productTypes} checked={['Roller shades']} columns={2} />
            <ChoiceGroup id="sg-union" legend="Union project?" name="sg-union" type="radio" options={unionOptions} checked={['Not sure']} />
            <TextField
              id="sg-about"
              class="md:col-span-2"
              label="Tell Us About Your Project"
              type="textarea"
              required
              hint="Please include the measurements, quantity, project location, expected timeline, and any other relevant details."
              error="Please tell us a little about your project."
            />
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6">
            <Button type="submit" size="lg">Submit Quote Request</Button>
            <p class="text-sm text-stone-600">We respond to qualified project and wholesale inquiries by email.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Badges and labels -->
    <section aria-labelledby="badges" class="mt-20 lg:mt-28">
      <SectionHeading
        id="badges"
        label="Labels"
        title="Badges and metadata labels"
        intro="Small capitals are reserved for spec labels and badges. Project facts sit in ruled spec tables, the way a submittal sheet lists them."
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4 lg:col-start-3">
          <p class="label-spec">On paper</p>
          <ul class="mt-3 flex flex-wrap items-center gap-3">
            <li><Badge>Sample write-up</Badge></li>
            <li><Badge variant="limestone">Union &amp; non-union projects</Badge></li>
          </ul>
          <p class="label-spec mt-8">On a photo</p>
          <div class="relative mt-3 aspect-4/3 overflow-hidden bg-stone-200">
            <Picture
              src={badgePhoto.src}
              alt=""
              width={800}
              height={600}
              layout="constrained"
              fit="cover"
              position={badgePhoto.position}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 330px, 100vw"
              formats={['avif', 'webp']}
              class="h-full w-full"
            />
            <Badge variant="paper" class="absolute top-3 left-3">Sample write-up</Badge>
            <Badge variant="ink" class="absolute bottom-3 left-3">17 photos</Badge>
          </div>
          <p class="mt-4 text-sm text-stone-600">
            “Sample write-up” marks placeholder projects on staging builds only. Paper and ink badges stay legible on any
            photo.
          </p>
        </div>
        <div class="lg:col-span-6">
          <SpecList
            items={[
              { label: 'Sector', value: 'Multifamily' },
              { label: 'Location', value: 'Rockford, IL' },
              { label: 'Year', value: '2024' },
              { label: 'Project type', value: 'Renovation' },
              { label: 'Products', value: 'Roller shades' },
              { label: 'Operation', value: 'Chain-operated' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- Section headings -->
    <section aria-labelledby="headings" class="mt-20 lg:mt-28">
      <SectionHeading
        id="headings"
        label="Headings"
        title="Section headings"
        intro="A 4 px mullion opens every section. The label sits in the narrow sash column; the title and intro sit in the wide pane."
      />
      <div class="mt-12 space-y-12">
        <SectionHeading
          level={3}
          label="Products"
          title="Our Products"
          intro="We offer a focused selection of window covering products for commercial, multifamily, and institutional applications."
        />
        <SectionHeading level={3} title="Without a label" intro="The pane stays aligned to the same column, so headings line up down the page." />
        <div data-surface="dark" class="p-6 lg:p-8">
          <SectionHeading
            level={3}
            surface="dark"
            label="Public sector"
            title="Government and Public-Sector Experience"
            intro="Roller Shade Supply has successfully completed government and public-sector projects, including window covering projects for multiple schools."
          />
        </div>
      </div>
    </section>

    <!-- Cards -->
    <section aria-labelledby="cards" class="mt-20 lg:mt-28">
      <SectionHeading
        id="cards"
        label="Cards"
        title="Project and product cards"
        intro="Cards are links: the whole card is clickable, and the top mullion turns redline on hover and focus. Project cards always show a real cover; product cards show an elevation drawing, never a project photo, so a card never implies proof we don't have."
      />
      <ul class="mt-10 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {sampleCards.map((project, i) => <li><ProjectCard project={project} demo={i === 1 ? 'hover' : undefined} /></li>)}
      </ul>
      <p class="mt-4 text-sm text-stone-600">The middle card shows the hover state.</p>
      <ul class="mt-12 grid gap-x-6 gap-y-12 md:grid-cols-3">
        <li>
          <ProductCard
            product="roller-shades"
            title="Roller Shades"
            href="/request-a-quote/?product=roller-shades"
            ctaLabel="Get Pricing for Roller Shades"
            description="Clean, versatile window coverings available in a variety of fabrics, colors, and operating options."
          />
        </li>
        <li>
          <ProductCard
            product="zebra-shades"
            title="Zebra Shades"
            href="/request-a-quote/?product=zebra-shades"
            ctaLabel="Get Pricing for Zebra Shades"
            demo="focus"
            description="A modern combination of light control and privacy, designed for offices, common areas, and contemporary interiors."
          />
        </li>
        <li>
          <ProductCard
            product="faux-wood-blinds"
            title="Faux Wood Blinds"
            href="/request-a-quote/?product=faux-wood-blinds"
            ctaLabel="Get Pricing for Faux Wood Blinds"
            description="A durable and practical option suitable for multifamily properties, offices, and other high-use environments."
          />
        </li>
      </ul>
      <p class="mt-4 text-sm text-stone-600">The middle card shows the focus state.</p>
    </section>

    <!-- Chicago window -->
    <section aria-labelledby="window" class="mt-20 lg:mt-28">
      <SectionHeading
        id="window"
        label="Frame"
        title="The Chicago window"
        intro="The signature frame: a wide fixed pane between two narrow sashes, 2–8–2 on the 12-column grid, divided by 4 px steel mullions. Each sash has a 1 px meeting rail that separates what you read from what you do. On phones, the pane comes first."
      />
      <ChicagoWindow class="mt-10" label="Chicago window frame diagram">
        <Fragment slot="left">
          <p class="label-spec">Left sash</p>
          <p class="text-sm">Facts about what’s in the pane.</p>
          <div data-rail="bottom"><p class="text-sm text-stone-700">2 of 12 columns</p></div>
        </Fragment>
        <div class="flex aspect-video items-center justify-center bg-stone-100 p-6">
          <div class="text-center">
            <p class="label-spec">Wide pane</p>
            <p class="mt-1 text-sm text-stone-700">8 of 12 columns: the photograph</p>
          </div>
        </div>
        <Fragment slot="right">
          <p class="label-spec">Right sash</p>
          <p class="text-sm">Actions.</p>
          <div data-rail="bottom"><p class="text-sm text-stone-700">2 of 12 columns</p></div>
        </Fragment>
      </ChicagoWindow>
    </section>

    <!-- Sample section -->
    <section aria-labelledby="sample" class="mt-20 lg:mt-28">
      <SectionHeading
        id="sample"
        label="Projects"
        title="Selected Projects"
        intro="Explore a selection of our completed commercial, multifamily, educational, and public-sector projects."
      />
      <ChicagoWindow class="mt-10" label={`Featured project: ${heroProject.data.title}`}>
        <Fragment slot="left">
          <p class="label-spec">Featured project</p>
          <p class="font-display text-xl font-extrabold">{heroProject.data.title}</p>
          <div data-rail="bottom">
            <SpecList
              size="compact"
              layout="stacked"
              items={[
                { label: 'Location', value: heroProject.data.location },
                { label: 'Product', value: 'Roller shades' },
                { label: 'Fabric', value: 'Light gray room-darkening' },
              ]}
            />
          </div>
        </Fragment>
        <Picture
          src={heroPhoto.src}
          alt={heroPhoto.alt}
          width={1920}
          height={1080}
          layout="constrained"
          fit="cover"
          position={heroPhoto.position}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="(min-width: 1280px) 820px, (min-width: 1024px) 64vw, 100vw"
          formats={['avif', 'webp']}
          class="block aspect-video h-auto w-full"
        />
        <Fragment slot="right">
          <p class="text-sm">Each project reflects our commitment to dependable products, professional coordination, and quality results.</p>
          <div data-rail="bottom" class="flex flex-col gap-3">
            <Button href={quoteCta.href} class="w-full">{quoteCta.label}</Button>
            <Button variant="secondary" href={projectHref(heroProject)} class="w-full">View Project</Button>
            <a class="link-quiet inline-block py-1 text-sm font-semibold" href={site.phone.href}>Call {site.phone.display}</a>
          </div>
        </Fragment>
      </ChicagoWindow>
      {heroProject.data.placeholder && <p class="mt-3 text-sm text-stone-600">Project details are a sample write-up until the client confirms them.</p>}
    </section>
  </div>
</BaseLayout>
