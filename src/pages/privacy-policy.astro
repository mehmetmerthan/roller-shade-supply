---
/**
 * Privacy Policy, written from the outline in docs/additional-content.md §11.
 * TODO(content): needs legal review before launch (CONTENT_TODO.md §4).
 */
import ProseLayout from '../layouts/ProseLayout.astro';
import { pageMeta } from '../copy/seo';
import { site } from '../config/site';

const path = '/privacy-policy/';
const meta = pageMeta[path];
---

<ProseLayout title="Privacy Policy" documentTitle={meta.title} description={meta.description} path={path} updated="11/05/2026">
  <h2>Who we are</h2>
  <p>
    {site.name} is a window covering supplier based in {site.address.city}, {site.address.region}. If you have questions about this
    policy, email us at <a class="link" href={`mailto:${site.email.general}`}>{site.email.general}</a>.
  </p>

  <h2>Information we collect</h2>
  <p>When you send us a quote request or contact us, we collect the details you choose to share:</p>
  <ul>
    <li>your name, company, email address, and phone number;</li>
    <li>the project location and project details, such as products, sizes, quantities, and timeline;</li>
    <li>any files you upload, such as plans or a measurement list.</li>
  </ul>
  <p>We also use basic, cookieless website analytics to understand how the site is used.</p>

  <h2>How we use it</h2>
  <p>We use your information to respond to your inquiry, prepare your quote, and communicate with you about your project.</p>

  <h2>Sharing</h2>
  <p>
    We share information only with service providers that help us operate the website and its forms, such as hosting, form processing,
    and email. We do not sell personal information.
  </p>

  <h2>Retention</h2>
  <p>We keep information as long as we need it for the purposes above, or as required by law.</p>

  <h2>Security</h2>
  <p>We take reasonable measures to protect the information you share with us.</p>

  <h2>Your choices</h2>
  <p>
    To access, correct, or delete your information, email us at <a class="link" href={`mailto:${site.email.general}`}>{site.email.general}</a>.
  </p>

  <h2>Changes</h2>
  <p>If we update this policy, we will post the new version on this page with a new date.</p>
</ProseLayout>
